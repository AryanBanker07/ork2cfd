# encoding: utf-8
# ANSYS Workbench Journal generated by ork2cfd for "{{ rocket.name }}"
# Run in batch mode:
#   "C:\Program Files\ANSYS Inc\{{ release_tag }}\Framework\bin\Win64\RunWB2.exe" -B -R "{{ wbjn_filename }}"

SetScriptVersion(Version="{{ wb_script_version }}")

try:
    template1 = GetTemplate(TemplateName="Fluid Flow with Fluent Meshing")
except Exception:
    template1 = GetTemplate(TemplateName="Fluid Flow")

system1 = template1.CreateSystem()
system1.DisplayText = "{{ display_name }}"

geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath=r"{{ step_path }}")

Save(FilePath=r"{{ wbpj_path }}", Overwrite=True)
{% if archive_wbpz %}
Archive(FilePath=r"{{ wbpz_path }}", IncludeExternalImportedFiles=True)
{% endif %}
