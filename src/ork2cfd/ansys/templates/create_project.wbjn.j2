# encoding: utf-8
# ANSYS Workbench Journal generated by ork2cfd for {{ rocket.name | replace('\n', ' ') | replace('\r', ' ') }}
# Run in batch mode:
#   "C:\Program Files\ANSYS Inc\{{ release_tag }}\Framework\bin\Win64\RunWB2.exe" -B -R {{ wbjn_filename | tojson }}

SetScriptVersion(Version={{ wb_script_version | tojson }})

try:
    template1 = GetTemplate(TemplateName="Fluid Flow with Fluent Meshing")
except Exception:
    template1 = GetTemplate(TemplateName="Fluid Flow")

system1 = template1.CreateSystem()
system1.DisplayText = {{ display_name | tojson }}

geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath={{ step_path | tojson }})

Save(FilePath={{ wbpj_path | tojson }}, Overwrite=True)
{% if archive_wbpz %}
Archive(FilePath={{ wbpz_path | tojson }}, IncludeExternalImportedFiles=True)
{% endif %}
