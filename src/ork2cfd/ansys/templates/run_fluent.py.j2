def _scaled_mesh_sizes(mesh_scale: float = 1.0) -> dict[str, float]:
    """Compute monotonically ordered spatial element sizes scaled by mesh_scale."""
    s = max(0.05, float(mesh_scale))
    if abs(s - 1.0) <= 1e-9:
        return {
            "surf_min": SURF_MIN_M,
            "surf_max": SURF_MAX_M,
            "fin_face": FIN_FACE_SIZE_M,
            "nose_face": NOSE_FACE_SIZE_M,
            "boi_nf": BOI_NF_SIZE_M,
            "boi_wake": BOI_WAKE_SIZE_M,
            "farfield_max": FARFIELD_MAX_M,
        }
    surf_min = round(max(1e-4, SURF_MIN_M * s), 6)
    surf_max = round(max(surf_min * 2.5, SURF_MAX_M * s), 6)
    fin_face = round(max(surf_min * 1.25, min(surf_max * 0.75, FIN_FACE_SIZE_M * s)), 6)
    nose_face = round(max(fin_face, min(surf_max * 0.90, NOSE_FACE_SIZE_M * s)), 6)
    boi_nf = round(max(surf_max, BOI_NF_SIZE_M * s), 6)
    boi_wake = round(max(boi_nf * 1.5, BOI_WAKE_SIZE_M * s), 6)
    farfield_max = round(max(boi_wake * 2.0, FARFIELD_MAX_M * s), 6)
    return {
        "surf_min": surf_min,
        "surf_max": surf_max,
        "fin_face": fin_face,
        "nose_face": nose_face,
        "boi_nf": boi_nf,
        "boi_wake": boi_wake,
        "farfield_max": farfield_max,
    }


def _get_meshing_utils(meshing_session):
    """Return the Fluent meshing_utilities handle in native -py or PyFluent."""
    if IN_FLUENT_PY:
        return globals().get("meshing_utilities")
    return getattr(meshing_session, "meshing_utilities", None)


def _euclid_dist(a: list[float], b: list[float]) -> float:
    """Return 3D Euclidean distance between two coordinate triples."""
    return math.sqrt(sum((float(x) - float(y)) ** 2 for x, y in zip(a, b)))


def _normalize_bbox(raw_bbox) -> tuple[list[float], list[float]] | None:
    """Normalize Fluent's nested or flat bounding box into (bmin, bmax) 3-lists."""
    if not raw_bbox:
        return None
    if (
        isinstance(raw_bbox, (list, tuple))
        and len(raw_bbox) == 2
        and isinstance(raw_bbox[0], (list, tuple))
        and isinstance(raw_bbox[1], (list, tuple))
        and len(raw_bbox[0]) >= 3
        and len(raw_bbox[1]) >= 3
    ):
        return (
            [float(raw_bbox[0][0]), float(raw_bbox[0][1]), float(raw_bbox[0][2])],
            [float(raw_bbox[1][0]), float(raw_bbox[1][1]), float(raw_bbox[1][2])],
        )
    if isinstance(raw_bbox, (list, tuple)) and len(raw_bbox) >= 6:
        return (
            [float(raw_bbox[0]), float(raw_bbox[1]), float(raw_bbox[2])],
            [float(raw_bbox[3]), float(raw_bbox[4]), float(raw_bbox[5])],
        )
    return None


def _aabb_metrics(
    zmin: list[float],
    zmax: list[float],
    rmin: list[float],
    rmax: list[float],
) -> tuple[float, float]:
    """Return (containment_overshoot_dist, exact_bbox_l2_dist) between two 3D AABBs."""
    over_sq = 0.0
    exact_sq = 0.0
    for k in range(3):
        ov_low = max(rmin[k] - zmin[k], 0.0)
        ov_high = max(zmax[k] - rmax[k], 0.0)
        over_sq += ov_low * ov_low + ov_high * ov_high
        exact_sq += (zmin[k] - rmin[k]) ** 2 + (zmax[k] - rmax[k]) ** 2
    return math.sqrt(over_sq), math.sqrt(exact_sq)


def _group_manifest_union_aabbs(m_faces: list[dict]) -> list[dict]:
    """Build union AABB candidates per canonical zone name alongside individual faces."""
    groups: dict[str, dict] = {}
    for mf in m_faces:
        zn = str(mf["zone"])
        bmin = [float(v) for v in (mf.get("bbox_min_m") or [0.0, 0.0, 0.0])]
        bmax = [float(v) for v in (mf.get("bbox_max_m") or [0.0, 0.0, 0.0])]
        area = float(mf.get("area_m2", 0.0) or 0.0)
        if zn not in groups:
            groups[zn] = {
                "zone": zn,
                "bbox_min_m": list(bmin),
                "bbox_max_m": list(bmax),
                "area_m2": area,
            }
        else:
            g = groups[zn]
            g["bbox_min_m"] = [min(a, b) for a, b in zip(g["bbox_min_m"], bmin)]
            g["bbox_max_m"] = [max(a, b) for a, b in zip(g["bbox_max_m"], bmax)]
            g["area_m2"] += area
    out: list[dict] = []
    for g in groups.values():
        g["bbox_center_m"] = [0.5 * (a + b) for a, b in zip(g["bbox_min_m"], g["bbox_max_m"])]
        out.append(g)
    return out


def _resolve_face_labels(available: list[str], targets: list[str]) -> list[str]:
    """Match requested Named Selection targets against verified Fluent face labels."""
    if not available:
        return []
    matched: list[str] = []
    for lbl in available:
        if any(lbl == t or t in lbl for t in targets) and lbl not in matched:
            matched.append(lbl)
    return matched


def _extract_zone_props(mu, zid: int) -> tuple[int, list[float], float, list[float] | None, list[float] | None]:
    """Query bbox center, area, and AABB bounds for a Fluent face zone ID."""
    zc = [float(v) for v in (mu.get_average_bounding_box_center(face_zone_id_list=[zid]) or [0.0, 0.0, 0.0])]
    za = float(mu.get_face_zone_area(face_zone_id_list=[zid]) or 0.0)
    raw_bb = None
    try:
        raw_bb = mu.get_bounding_box_of_zone_list(zone_id_list=[zid])
    except Exception:
        raw_bb = None
    bb = _normalize_bbox(raw_bb)
    if bb is not None:
        return zid, zc, za, bb[0], bb[1]
    return zid, zc, za, None, None


def _ensure_zone_labels_from_manifest(
    meshing_session,
    manifest: dict,
    rename_fluid: bool = False,
) -> tuple[str, dict[str, str]]:
    """
    Ensure imported CAD objects and face zones carry exact manifest Named Selection labels.

    Works around STEP readers that omit Layer/Color Named Selections by matching each
    imported face zone's bbox center and area 1-to-1 against manifest metadata.
    """
    mu = _get_meshing_utils(meshing_session)
    if mu is None:
        print("[ork2cfd] Note: meshing_utilities unavailable; using native CAD labels only.")
        return "", {}

    objs = [str(o) for o in (mu.get_all_objects() or [])]
    print(f"[ork2cfd] Imported CAD objects ({len(objs)}): {objs}")
    if not objs:
        return "", {}

    obj_stats: dict[str, tuple[list[int], list[float], float]] = {}
    for obj in objs:
        zids = [int(z) for z in (mu.get_face_zones_of_object(object_name=obj) or [])]
        center = (
            [float(v) for v in (mu.get_average_bounding_box_center(face_zone_id_list=zids) or [0.0, 0.0, 0.0])]
            if zids
            else [0.0, 0.0, 0.0]
        )
        area = float(mu.get_face_zone_area(face_zone_id_list=zids) or 0.0) if zids else 0.0
        obj_stats[obj] = (zids, center, area)
        print(f"[ork2cfd]   object '{obj}': {len(zids)} face zone(s), area={area:.4f} m^2, center={center}")

    # Identify fluid domain object (keep origin- prefix before Generate the Surface Mesh when rename_fluid=False)
    fluid_obj = next(
        (
            o
            for o in objs
            if any(tok in o.lower() for tok in ("fluid_domain", "rocket_oml"))
            and "boi_" not in o.lower()
        ),
        None,
    )
    if fluid_obj is None:
        fluid_obj = max(objs, key=lambda o: obj_stats[o][2])

    if rename_fluid and fluid_obj != "fluid_domain" and "fluid_domain" in manifest.get("solid_names", []):
        try:
            mu.rename_object(old_object_name=fluid_obj, new_object_name="fluid_domain")
            new_objs = [str(o) for o in (mu.get_all_objects() or [])]
            if "fluid_domain" in new_objs:
                obj_stats["fluid_domain"] = obj_stats.pop(fluid_obj)
                objs = new_objs
                fluid_obj = "fluid_domain"
        except Exception as exc:
            print(f"[ork2cfd] Note: could not rename fluid object '{fluid_obj}': {exc}")

    # Identify and label BOI objects
    boi_map: dict[str, str] = {}
    boi_meta = manifest.get("boi_solids_meta", {}) or {}
    other_objs = [o for o in objs if o != fluid_obj]
    unmatched_bois = list(boi_meta.keys())
    unmatched_objs = list(other_objs)

    for boi_name in list(unmatched_bois):
        name_hit = next((o for o in unmatched_objs if boi_name in o.lower()), None)
        if name_hit is not None:
            boi_map[boi_name] = name_hit
            unmatched_bois.remove(boi_name)
            unmatched_objs.remove(name_hit)

    if unmatched_bois and unmatched_objs:
        pairs: list[tuple[float, str, str]] = []
        ref_scale = max(L_REF_M, 0.1)
        for boi_name in unmatched_bois:
            bm = boi_meta.get(boi_name, {})
            bcen = bm.get("bbox_center_m", [0.0, 0.0, 0.0])
            barea = float(bm.get("area_m2", 0.0))
            for obj in unmatched_objs:
                _, oc, oa = obj_stats[obj]
                dist_cost = _euclid_dist(oc, bcen) / ref_scale
                area_cost = abs(oa - barea) / max(oa, barea, 1e-6) if barea > 0 else 0.0
                pairs.append((dist_cost + 0.5 * area_cost, boi_name, obj))
        pairs.sort(key=lambda item: item[0])
        used_b: set[str] = set()
        used_o: set[str] = set()
        for _cost, boi_name, obj in pairs:
            if boi_name in used_b or obj in used_o:
                continue
            boi_map[boi_name] = obj
            used_b.add(boi_name)
            used_o.add(obj)

    for boi_name, cur_obj in list(boi_map.items()):
        active_obj = cur_obj
        if active_obj != boi_name:
            try:
                mu.rename_object(old_object_name=active_obj, new_object_name=boi_name)
                cur_all = [str(o) for o in (mu.get_all_objects() or [])]
                if boi_name in cur_all:
                    obj_stats[boi_name] = obj_stats.pop(active_obj)
                    active_obj = boi_name
                    boi_map[boi_name] = active_obj
            except Exception as exc:
                print(f"[ork2cfd] Note: could not rename BOI object '{active_obj}': {exc}")
        bzids = obj_stats.get(active_obj, ([], [], 0.0))[0]
        if not bzids:
            bzids = [int(z) for z in (mu.get_face_zones_of_object(object_name=active_obj) or [])]
        existing_boi_lbls = {str(lbl) for lbl in (mu.get_labels(object_name=active_obj) or [])}
        if boi_name not in existing_boi_lbls and bzids:
            try:
                mu.add_labels_on_face_zones(face_zone_id_list=bzids, label_name_list=[boi_name])
                print(f"[ork2cfd] Applied BOI label '{boi_name}' on object '{active_obj}' zones {bzids}")
            except Exception as exc:
                print(f"[ork2cfd] Warning: failed to label BOI '{boi_name}': {exc}")

    # Verify or reconstruct face Named Selection labels on fluid_obj
    existing_fluid_lbls = {str(lbl) for lbl in (mu.get_labels(object_name=fluid_obj) or [])}
    expected_zones = set((manifest.get("named_selections_counts", {}) or {}).keys())
    print(f"[ork2cfd] Existing labels on '{fluid_obj}': {sorted(existing_fluid_lbls)}")

    if not expected_zones.issubset(existing_fluid_lbls):
        fluid_zids = [int(z) for z in (mu.get_face_zones_of_object(object_name=fluid_obj) or [])]
        m_faces = list(manifest.get("named_selections_faces", []) or [])
        if not m_faces:
            for zname, pts in (manifest.get("named_selections_centroids_m", {}) or {}).items():
                for pt in pts:
                    m_faces.append({"zone": zname, "bbox_center_m": pt, "centroid_m": pt, "area_m2": 0.0})

        if fluid_zids and m_faces:
            zone_props = [_extract_zone_props(mu, zid) for zid in fluid_zids]
            ref_scale = max(L_REF_M, 0.1)
            cost_tuples: list[tuple[float, int, int]] = []
            for i, (_zid, zc, za, _zbmin, _zbmax) in enumerate(zone_props):
                for j, mf in enumerate(m_faces):
                    ref_cen = mf.get("bbox_center_m") or mf.get("centroid_m") or [0.0, 0.0, 0.0]
                    ref_area = float(mf.get("area_m2", 0.0) or 0.0)
                    d_norm = _euclid_dist(zc, ref_cen) / ref_scale
                    a_norm = (abs(za - ref_area) / max(za, ref_area, 1e-8)) if ref_area > 0 else 0.0
                    cost_tuples.append((d_norm + 0.5 * a_norm, i, j))
            cost_tuples.sort(key=lambda item: item[0])

            assigned_row: dict[int, int] = {}
            used_cols: set[int] = set()
            for _cost, i, j in cost_tuples:
                if i in assigned_row or j in used_cols:
                    continue
                assigned_row[i] = j
                used_cols.add(j)

            if len(assigned_row) < len(zone_props):
                for _cost, i, j in cost_tuples:
                    if i not in assigned_row:
                        assigned_row[i] = j

            grouped_zids: dict[str, list[int]] = {}
            for i, j in assigned_row.items():
                zname = str(m_faces[j]["zone"])
                grouped_zids.setdefault(zname, []).append(zone_props[i][0])

            print(
                "[ork2cfd] Manifest face-to-zone reconstruction:",
                {k: len(v) for k, v in sorted(grouped_zids.items())},
            )
            for zname, zids in sorted(grouped_zids.items()):
                try:
                    mu.add_labels_on_face_zones(face_zone_id_list=zids, label_name_list=[zname])
                    if len(zids) > 1:
                        mu.merge_face_zones(face_zone_id_list=zids)
                    surviving = [
                        int(z)
                        for z in (mu.get_face_zones_of_object(object_name=fluid_obj, labels=[zname]) or [])
                    ]
                    if len(surviving) == 1:
                        mu.rename_face_zone(zone_id=surviving[0], new_name=zname)
                except Exception as exc:
                    print(f"[ork2cfd] Warning: zone labeling/merge for '{zname}' failed: {exc}")

    final_labels = sorted(str(lbl) for lbl in (mu.get_labels(object_name=fluid_obj) or []))
    print(f"[ork2cfd] Verified labels on '{fluid_obj}': {final_labels}")
    return fluid_obj, boi_map


def _label_remeshed_object_from_manifest(
    meshing_session,
    manifest: dict,
    remesh_obj: str,
) -> list[str]:
    """
    Classify separated face zones on the remeshed mesh object into canonical zones.

    Strips catch-all body labels (e.g. 'fluid_domain-fluid_domain'), matches each
    separated zone via 3D AABB overshoot + exact AABB L2 + centroid + area against
    both individual manifest faces and per-zone union AABBs, merges faces per
    canonical zone, and renames surviving zones cleanly.
    """
    mu = _get_meshing_utils(meshing_session)
    if mu is None or not remesh_obj:
        return []

    zids = [int(z) for z in (mu.get_face_zones_of_object(object_name=remesh_obj) or [])]
    if not zids:
        return []

    old_lbls = [str(lbl) for lbl in (mu.get_labels(object_name=remesh_obj) or [])]

    m_faces = list(manifest.get("named_selections_faces", []) or [])
    if not m_faces:
        for zname, pts in (manifest.get("named_selections_centroids_m", {}) or {}).items():
            for pt in pts:
                m_faces.append(
                    {
                        "zone": zname,
                        "bbox_min_m": pt,
                        "bbox_max_m": pt,
                        "bbox_center_m": pt,
                        "centroid_m": pt,
                        "area_m2": 0.0,
                    }
                )
    if not m_faces:
        return []

    candidates = list(m_faces) + _group_manifest_union_aabbs(m_faces)

    # Precompute tangent nosecone/body extents so a smoothly tangent merged nose+body is caught
    nose_faces = [mf for mf in m_faces if mf.get("zone") == "rocket_nosecone"]
    body_faces = [mf for mf in m_faces if mf.get("zone") == "rocket_body"]
    nose_xmax = 0.0
    max_r_nb = 0.0
    check_merged_nose_body = bool(nose_faces and body_faces)
    if check_merged_nose_body:
        nose_xmax = max(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[0]) for mf in nose_faces)
        nose_rmax = max(
            max(
                abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[1])),
                abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[1])),
                abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[2])),
                abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[2])),
            )
            for mf in nose_faces
        )
        body_rmax = max(
            max(
                abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[1])),
                abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[1])),
                abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[2])),
                abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[2])),
            )
            for mf in body_faces
        )
        max_r_nb = max(nose_rmax, body_rmax, 1e-4)

    ref_scale = max(L_REF_M, 0.1)
    grouped_zids: dict[str, list[int]] = {}

    for zid in zids:
        _zid, zc, za, zmin, zmax = _extract_zone_props(mu, zid)

        if check_merged_nose_body and zmin is not None and zmax is not None:
            rad_extent = max(abs(zmin[1]), abs(zmax[1]), abs(zmin[2]), abs(zmax[2]))
            if zmin[0] <= nose_xmax * 0.4 and zmax[0] >= nose_xmax + 0.05 and rad_extent <= max_r_nb * 2.2:
                grouped_zids.setdefault("rocket_body", []).append(zid)
                print(f"[ork2cfd]   remesh zone {zid}: area={za:.5f}, x=[{zmin[0]:.3f},{zmax[0]:.3f}] -> rocket_body (merged nose+body)")
                continue

        best_zone = ""
        best_score = float("inf")
        for cand in candidates:
            ref_cen = cand.get("bbox_center_m") or cand.get("centroid_m") or [0.0, 0.0, 0.0]
            ref_area = float(cand.get("area_m2", 0.0) or 0.0)
            rmin = cand.get("bbox_min_m")
            rmax = cand.get("bbox_max_m")

            cen_norm = _euclid_dist(zc, ref_cen) / ref_scale
            if zmin is not None and zmax is not None and rmin is not None and rmax is not None:
                over_d, exact_d = _aabb_metrics(zmin, zmax, [float(v) for v in rmin], [float(v) for v in rmax])
                over_norm = over_d / ref_scale
                exact_norm = exact_d / ref_scale
            else:
                over_norm = 0.0
                exact_norm = 0.0

            area_norm = (
                abs(za - ref_area) / max(za, ref_area, 1e-8)
                if (ref_area > 0.0 and za >= 0.4 * ref_area)
                else 0.0
            )
            score = 5.0 * over_norm + 1.5 * exact_norm + 1.0 * cen_norm + 0.35 * area_norm
            if score < best_score:
                best_score = score
                best_zone = str(cand["zone"])

        if best_zone:
            grouped_zids.setdefault(best_zone, []).append(zid)
            if zmin is not None and zmax is not None:
                print(f"[ork2cfd]   remesh zone {zid}: area={za:.5f}, x=[{zmin[0]:.3f},{zmax[0]:.3f}] -> {best_zone}")

    print(
        f"[ork2cfd] Post-remesh face-to-zone classification on '{remesh_obj}':",
        {k: len(v) for k, v in sorted(grouped_zids.items())},
    )
    for zname, zl in sorted(grouped_zids.items()):
        try:
            mu.add_labels_on_face_zones(face_zone_id_list=zl, label_name_list=[zname])
            if len(zl) > 1:
                mu.merge_face_zones(face_zone_id_list=zl)
            surviving = [
                int(z)
                for z in (mu.get_face_zones_of_object(object_name=remesh_obj, labels=[zname]) or [])
            ]
            if len(surviving) == 1:
                mu.rename_face_zone(zone_id=surviving[0], new_name=zname)
        except Exception as exc:
            print(f"[ork2cfd] Warning: post-remesh labeling/merge for '{zname}' failed: {exc}")

    # Remove catch-all body labels only AFTER every zone holds a canonical label
    stale_lbls = [lbl for lbl in old_lbls if lbl not in grouped_zids]
    if stale_lbls:
        cur_zids = [int(z) for z in (mu.get_face_zones_of_object(object_name=remesh_obj) or [])]
        if cur_zids:
            try:
                mu.remove_labels_on_face_zones(face_zone_id_list=cur_zids, label_name_list=stale_lbls)
            except Exception as exc:
                print(f"[ork2cfd] Note removing stale labels {stale_lbls} on '{remesh_obj}': {exc}")

    final_labels = sorted(str(lbl) for lbl in (mu.get_labels(object_name=remesh_obj) or []))
    print(f"[ork2cfd] Verified labels on remeshed '{remesh_obj}': {final_labels}")
    return final_labels


def _apply_local_sizing(
    wf,
    meshing_session,
    fluid_obj: str,
    boi_map: dict[str, str],
    mesh_scale: float = 1.0,
) -> list[str]:
    """Apply local face sizing on rocket walls and Body-of-Influence refinement."""
    add_sizing = wf.TaskObject["Add Local Sizing"]
    mu = _get_meshing_utils(meshing_session)
    sizes = _scaled_mesh_sizes(mesh_scale)

    verified_labels: list[str] = []
    if mu is not None and fluid_obj:
        verified_labels = [str(lbl) for lbl in (mu.get_labels(object_name=fluid_obj) or [])]
    try:
        args_now = add_sizing.Arguments()
        if isinstance(args_now, dict):
            complete_lbls = [str(lbl) for lbl in (args_now.get("CompleteFaceLabelList", []) or [])]
            for lbl in complete_lbls:
                if lbl not in verified_labels:
                    verified_labels.append(lbl)
    except Exception as exc:
        print(f"[ork2cfd] Note: could not query CompleteFaceLabelList: {exc}")
    print(f"[ork2cfd] Available labels for local sizing: {sorted(verified_labels)}")

    controls = [
        ("fin_face_sizing", "Face Size", sizes["fin_face"], ["rocket_fins"]),
        ("nose_face_sizing", "Face Size", sizes["nose_face"], ["rocket_nosecone"]),
        (
            "body_face_sizing",
            "Face Size",
            sizes["surf_max"],
            ["rocket_body", "rocket_boattail", "rocket_base"],
        ),
        ("boi_nearfield_sizing", "Body Of Influence", sizes["boi_nf"], ["boi_nearfield"]),
        ("boi_wake_sizing", "Body Of Influence", sizes["boi_wake"], ["boi_wake"]),
    ]

    all_known = list(verified_labels)
    for bname in boi_map:
        if bname not in all_known:
            all_known.append(bname)

    for ctrl_name, exec_mode, size_m, targets in controls:
        labels = _resolve_face_labels(
            all_known if exec_mode == "Body Of Influence" else verified_labels,
            targets,
        )
        if not labels:
            print(f"[ork2cfd] Local sizing '{ctrl_name}' skipped: no verified labels matched {targets}")
            continue
        try:
            add_sizing.Arguments.set_state({"BOIExecution": exec_mode})
            args_exec = add_sizing.Arguments() or {}
            avail_mode = [str(lbl) for lbl in (args_exec.get("CompleteFaceLabelList", []) or [])]
            if avail_mode:
                mode_labels = _resolve_face_labels(avail_mode, targets)
                if mode_labels:
                    labels = mode_labels
            add_sizing.Arguments.set_state({
                "AddChild": "yes",
                "BOIControlName": ctrl_name,
                "BOIExecution": exec_mode,
                "BOISize": size_m,
                "BOIFaceLabelList": labels,
            })
            add_sizing.AddChildAndUpdate()
            print(f"[ork2cfd] Added local sizing '{ctrl_name}' ({exec_mode}, {size_m} m): {labels}")
        except Exception as exc:
            print(f"[ork2cfd] Local sizing '{ctrl_name}' skipped: {exc}")
    add_sizing.Execute()
    return sorted(verified_labels)


def _target_bc_for_name(name: str, farfield_bc: str, outlet_bc: str, use_compressible: bool) -> str:
    """Map an ork2cfd zone/label name to its Fluent Meshing boundary type."""
    low = name.lower()
    if "farfield" in low:
        return farfield_bc
    if "inlet" in low:
        return farfield_bc if use_compressible else "velocity-inlet"
    if "outlet" in low:
        return outlet_bc
    if "symmetry" in low:
        return "symmetry"
    return "wall"


def _separate_remeshed_zones(
    meshing_session,
    mu,
    manifest: dict,
    remesh_obj: str,
    angle_deg: float = 15.0,
) -> list[int]:
    """Separate all unlabeled/merged shells on the remeshed object by feature angle."""
    rzids = [int(z) for z in (mu.get_face_zones_of_object(object_name=remesh_obj) or [])]
    expected_zones = set((manifest.get("named_selections_counts", {}) or {}).keys())
    existing_lbls = {str(lbl) for lbl in (mu.get_labels(object_name=remesh_obj) or [])}

    labeled_zids: set[int] = set()
    for elbl in sorted(expected_zones & existing_lbls):
        try:
            for zid in (mu.get_face_zones_of_object(object_name=remesh_obj, labels=[elbl]) or []):
                labeled_zids.add(int(zid))
        except Exception:
            pass

    labels_incomplete = bool(expected_zones) and not expected_zones.issubset(existing_lbls)
    too_few_zones = (len(rzids) < len(expected_zones)) if expected_zones else (len(rzids) <= 2)
    if not rzids or not (too_few_zones or labels_incomplete):
        return rzids

    zones_to_sep = [z for z in rzids if z not in labeled_zids] or list(rzids)
    for zid in zones_to_sep:
        try:
            meshing_session.tui.boundary.separate.sep_face_zone_by_angle([zid], angle_deg)
        except Exception as exc:
            print(f"[ork2cfd] Warning: sep_face_zone_by_angle({zid}) failed: {exc}")

    after_rzids = [int(z) for z in (mu.get_face_zones_of_object(object_name=remesh_obj) or [])]
    print(
        f"[ork2cfd] Separated remeshed zones {zones_to_sep} by {angle_deg:.1f} deg feature angle "
        f"({len(rzids)} -> {len(after_rzids)} face zones)."
    )
    return after_rzids


def _classify_region_types(
    region_names: list[str],
    region_volumes: dict[str, float] | None = None,
) -> list[str]:
    """Classify Watertight regions so only the outer fluid enclosure is 'fluid' and voids/BOIs are 'dead'."""
    if not region_names:
        return []

    def _is_explicit_dead(name: str) -> bool:
        low = name.lower()
        return (
            "boi" in low
            or low.startswith("dead")
            or "void" in low
            or "rocket" in low
        )

    candidates = [
        (idx, str(rn))
        for idx, rn in enumerate(region_names)
        if not _is_explicit_dead(str(rn))
    ]
    chosen_idx: int | None = None

    if len(candidates) == 1:
        chosen_idx = candidates[0][0]
    elif len(candidates) > 1:
        vols = region_volumes or {}
        positive_cands = [
            (idx, name) for idx, name in candidates if float(vols.get(name, -1.0)) > 0.0
        ]
        if positive_cands:
            chosen_idx = max(positive_cands, key=lambda item: float(vols.get(item[1], -1.0)))[0]
        else:
            chosen_idx = (
                next((idx for idx, name in candidates if "fluid_domain" in name.lower()), None)
                or next((idx for idx, name in candidates if "enclosure" in name.lower()), None)
                or candidates[0][0]
            )
    else:
        non_boi = [
            (idx, str(rn))
            for idx, rn in enumerate(region_names)
            if "boi" not in str(rn).lower()
        ]
        vols = region_volumes or {}
        positive_nb = [
            (idx, name) for idx, name in non_boi if float(vols.get(name, -1.0)) > 0.0
        ]
        if positive_nb:
            chosen_idx = max(positive_nb, key=lambda item: float(vols.get(item[1], -1.0)))[0]
        elif non_boi:
            chosen_idx = (
                next(
                    (
                        idx
                        for idx, name in non_boi
                        if "fluid_domain" in name.lower() and not name.lower().startswith("dead")
                    ),
                    None,
                )
                or non_boi[0][0]
            )

    return ["fluid" if idx == chosen_idx else "dead" for idx in range(len(region_names))]


def _fallback_change_region_types(
    meshing_session,
    remesh_obj: str,
    r_names: list[str],
    r_types: list[str],
) -> None:
    """Fallback to meshing TUI volumetric_regions.change_type if workflow set_state fails."""
    if meshing_session is None or not remesh_obj:
        return
    for rn, rt in zip(r_names, r_types):
        if rt == "dead":
            try:
                meshing_session.tui.objects.volumetric_regions.change_type(remesh_obj, [rn], "dead")
            except Exception as exc:
                print(f"[ork2cfd] Fallback change_type('{rn}', 'dead') note: {exc}")


def _update_boundaries_and_regions(
    wf,
    use_compressible: bool,
    verified_labels: list[str] | None = None,
    meshing_session=None,
    remesh_obj: str = "",
    has_voids: bool = False,
) -> None:
    """Explicitly assign boundary types and region fluid/dead types before boundary layer prism growth."""
    farfield_bc = "pressure-far-field" if use_compressible else "{{ solver_rec.farfield_bc_type }}"
    outlet_bc = "pressure-far-field" if use_compressible else "{{ solver_rec.outlet_bc_type }}"

    upd_b = wf.TaskObject["Update Boundaries"]
    try:
        b_args = upd_b.Arguments() or {}
        if isinstance(b_args, dict):
            sel_type = str(b_args.get("SelectionType", "label") or "label")
            lbls = list(b_args.get("BoundaryLabelList", []) or [])
            zones = list(b_args.get("BoundaryZoneList", []) or [])
            if not lbls and not zones and verified_labels:
                lbls = [
                    str(lbl)
                    for lbl in verified_labels
                    if "boi_" not in str(lbl).lower() and "-fluid_domain" not in str(lbl).lower()
                ]
                sel_type = "label"
            elif lbls:
                lbls = [str(lbl) for lbl in lbls if "-fluid_domain" not in str(lbl).lower()]
            print(f"[ork2cfd] Update Boundaries ({sel_type}): labels={lbls}, zones={zones}")
            if sel_type == "label" and lbls:
                b_types = [_target_bc_for_name(n, farfield_bc, outlet_bc, use_compressible) for n in lbls]
                upd_b.Arguments.set_state({
                    "SelectionType": "label",
                    "BoundaryLabelList": lbls,
                    "BoundaryLabelTypeList": b_types,
                })
                print(f"[ork2cfd] Set boundary label types: {dict(zip(lbls, b_types))}")
            elif zones:
                z_types = [_target_bc_for_name(n, farfield_bc, outlet_bc, use_compressible) for n in zones]
                upd_b.Arguments.set_state({
                    "BoundaryZoneList": zones,
                    "BoundaryZoneTypeList": z_types,
                })
                print(f"[ork2cfd] Set boundary zone types: {dict(zip(zones, z_types))}")
    except Exception as exc:
        print(f"[ork2cfd] Note inspecting/setting Update Boundaries: {exc}")
    upd_b.Execute()

    if has_voids:
        try:
            cr_task = wf.TaskObject["Create Regions"]
            raw_state = getattr(cr_task, "State", None)
            cr_state = str(raw_state() if callable(raw_state) else (raw_state or "")).lower()
            if cr_state not in {"hidden", "up-to-date", "forced-up-to-date"}:
                try:
                    cr_task.Arguments.set_state({"NumberOfFlowVolumes": 0})
                except Exception as exc:
                    print(f"[ork2cfd] Create Regions NumberOfFlowVolumes note: {exc}")
                cr_task.Execute()
        except Exception as exc:
            print(f"[ork2cfd] Meshing step 'Create Regions' note: {exc}")

    try:
        ur_task = wf.TaskObject["Update Regions"]
        r_args = ur_task.Arguments() or {}
        r_names: list[str] = []
        if isinstance(r_args, dict):
            for key in ("RegionNameList", "RegionCurrentList", "OldRegionNameList"):
                cand = list(r_args.get(key, []) or [])
                if cand:
                    r_names = [str(rn) for rn in cand]
                    break
        mu = _get_meshing_utils(meshing_session) if meshing_session is not None else None
        if not r_names and mu is not None and remesh_obj:
            try:
                r_names = [
                    str(rn)
                    for rn in (mu.get_regions(object_name=remesh_obj, region_name_pattern="*") or [])
                ]
            except Exception as exc:
                print(f"[ork2cfd] Note querying regions on '{remesh_obj}': {exc}")

        r_vols: dict[str, float] = {}
        if len(r_names) > 1 and mu is not None and remesh_obj:
            for rn in r_names:
                try:
                    raw_v = mu.get_region_volume(object_name=remesh_obj, region_name=rn)
                    if isinstance(raw_v, (int, float)):
                        r_vols[rn] = float(raw_v)
                    elif isinstance(raw_v, (list, tuple)) and raw_v and isinstance(raw_v[0], (int, float)):
                        r_vols[rn] = float(raw_v[0])
                except Exception:
                    pass

        if r_names:
            r_types = _classify_region_types(r_names, r_vols or None)
            state_payload: dict[str, object] = {
                "RegionNameList": r_names,
                "RegionTypeList": r_types,
            }
            if isinstance(r_args, dict):
                old_names = list(r_args.get("OldRegionNameList", []) or [])
                old_types = list(r_args.get("OldRegionTypeList", []) or [])
                if len(old_names) == len(r_names) and len(old_types) == len(r_names):
                    state_payload["OldRegionNameList"] = [str(x) for x in old_names]
                    state_payload["OldRegionTypeList"] = [str(x) for x in old_types]
            try:
                ur_task.Arguments.set_state(state_payload)
            except Exception as exc:
                if "OldRegionNameList" in state_payload:
                    try:
                        ur_task.Arguments.set_state({
                            "RegionNameList": r_names,
                            "RegionTypeList": r_types,
                        })
                    except Exception as inner_exc:
                        print(f"[ork2cfd] Update Regions set_state note: {inner_exc}")
                        _fallback_change_region_types(meshing_session, remesh_obj, r_names, r_types)
                else:
                    print(f"[ork2cfd] Update Regions set_state note: {exc}")
                    _fallback_change_region_types(meshing_session, remesh_obj, r_names, r_types)
            vol_info = f", volumes={r_vols}" if r_vols else ""
            print(f"[ork2cfd] Update Regions: {dict(zip(r_names, r_types))}{vol_info}")
        ur_task.Execute()
    except Exception as exc:
        print(f"[ork2cfd] Meshing step 'Update Regions' note: {exc}")


def _extract_computed_scalar(computed_obj, name: str) -> float | None:
    """Extract numeric scalar from solver.settings.solution.report_definitions.compute()."""
    if isinstance(computed_obj, (list, tuple)):
        for item in computed_obj:
            found = _extract_computed_scalar(item, name)
            if found is not None:
                return found
        return None
    if isinstance(computed_obj, dict):
        if name in computed_obj:
            val = computed_obj[name]
            if isinstance(val, (int, float)):
                return float(val)
            if isinstance(val, dict) and val:
                first_v = next(iter(val.values()))
                if isinstance(first_v, (int, float)):
                    return float(first_v)
                if isinstance(first_v, (list, tuple)) and first_v:
                    return float(first_v[0])
            if isinstance(val, (list, tuple)) and val:
                return float(val[0])
        for v in computed_obj.values():
            found = _extract_computed_scalar(v, name)
            if found is not None:
                return found
    return None


def _run_meshing(
    meshing_session,
    wf,
    manifest: dict,
    active_machs: list[float],
    mesh_scale: float = 1.0,
) -> tuple[int | None, float | None]:
    """Execute Watertight Geometry workflow, preserve/reconstruct zones, and save mesh."""
    sizes = _scaled_mesh_sizes(mesh_scale)
    if abs(float(mesh_scale) - 1.0) > 1e-9:
        print(
            f"[ork2cfd] Active mesh_scale={float(mesh_scale):.4f}: "
            f"surf={sizes['surf_min']:.5f}..{sizes['surf_max']:.5f} m, "
            f"fin={sizes['fin_face']:.5f} m, boi_nf={sizes['boi_nf']:.5f} m, "
            f"farfield={sizes['farfield_max']:.5f} m (y+ FirstHeight={FIRST_LAYER_M:.3e} m fixed)"
        )
    wf.InitializeWorkflow(WorkflowType="Watertight Geometry")

    import_geo = wf.TaskObject["Import Geometry"]
    try:
        import_geo.Arguments.set_state({
            "FileName": STEP_FILE.name,
            "LengthUnit": "m",
            "CadImportOptions": {
                "OneZonePer": "face",
                "OneObjectPer": "Part",
                "ImportPartNames": True,
                "ImportNamedSelections": True,
            },
        })
    except Exception as exc:
        print(f"[ork2cfd] CadImportOptions note ({exc}); using standard STEP import")
        import_geo.Arguments.set_state({
            "FileName": STEP_FILE.name,
            "LengthUnit": "m",
        })
    if not import_geo.Execute():
        raise RuntimeError(f"Fluent Import Geometry failed for '{STEP_FILE}'.")

    fluid_obj, boi_map = _ensure_zone_labels_from_manifest(meshing_session, manifest, rename_fluid=False)
    verified_labels = _apply_local_sizing(wf, meshing_session, fluid_obj, boi_map, mesh_scale=mesh_scale)

    mu = _get_meshing_utils(meshing_session)
    pre_sm_objs = {str(o) for o in (mu.get_all_objects() or [])} if mu is not None else set()

    surf_mesh = wf.TaskObject["Generate the Surface Mesh"]
    surf_mesh.Arguments.set_state({
        "CFDSurfaceMeshControls": {
            "MinSize": sizes["surf_min"],
            "MaxSize": sizes["farfield_max"],
            "GrowthRate": 1.2,
            "CurvatureNormalAngle": 12.0,
        }
    })
    if not surf_mesh.Execute():
        raise RuntimeError("Fluent Generate the Surface Mesh failed.")

    # Generate the Surface Mesh re-tessellates PMDB with 1 zone per body; separate & re-label now
    remesh_obj = fluid_obj
    if mu is not None:
        post_sm_objs = [str(o) for o in (mu.get_all_objects() or [])]
        new_remesh = [o for o in post_sm_objs if o not in pre_sm_objs and "boi_" not in o.lower()]
        if not new_remesh:
            new_remesh = [
                o for o in post_sm_objs
                if not o.startswith("origin-") and "boi_" not in o.lower()
            ]
        remesh_obj = new_remesh[0] if new_remesh else fluid_obj
        print(f"[ork2cfd] Post-SM objects={post_sm_objs}; active remesh object='{remesh_obj}'")
        _separate_remeshed_zones(meshing_session, mu, manifest, remesh_obj, angle_deg=15.0)
        post_labels = _label_remeshed_object_from_manifest(meshing_session, manifest, remesh_obj)
        if post_labels:
            verified_labels = post_labels

    pre_regions: list[str] = []
    if mu is not None and remesh_obj:
        try:
            pre_regions = [
                str(r)
                for r in (mu.get_regions(object_name=remesh_obj, region_name_pattern="*") or [])
            ]
        except Exception as exc:
            print(f"[ork2cfd] Note querying post-SM regions on '{remesh_obj}': {exc}")
    has_voids = (
        any(r.lower().startswith("dead") or "void" in r.lower() for r in pre_regions)
        or len(pre_regions) > 1
        or (DOMAIN_MODE == "fluid_domain")
    )
    print(f"[ork2cfd] Post-SM regions on '{remesh_obj}': {pre_regions} (has_voids={has_voids})")

    desc_geo = wf.TaskObject["Describe Geometry"]
    desc_geo.UpdateChildTasks(SetupTypeChanged=True)
    if has_voids:
        void_setup = "The geometry consists of both fluid and solid regions and/or voids"
        for payload in (
            {
                "SetupType": void_setup,
                "CappingRequired": "No",
                "InvokeShareTopology": "No",
                "WallToInternal": "No",
            },
            {
                "SetupType": void_setup,
                "CappingRequired": "No",
            },
            {
                "SetupType": void_setup,
            },
        ):
            try:
                desc_geo.Arguments.set_state(payload)
                break
            except Exception as exc:
                print(f"[ork2cfd] Describe Geometry payload note ({exc}); trying simpler option")
    else:
        desc_geo.Arguments.set_state({
            "SetupType": "The geometry consists of only fluid regions with no voids",
        })
    desc_geo.UpdateChildTasks(SetupTypeChanged=True)
    desc_geo.Execute()

    use_compressible = {{ "True" if solver_rec.energy_enabled else "False" }} or any(
        m >= 0.3 for m in active_machs
    )
    _update_boundaries_and_regions(
        wf,
        use_compressible,
        verified_labels=verified_labels,
        meshing_session=meshing_session,
        remesh_obj=remesh_obj,
        has_voids=has_voids,
    )

    # Set AddChild + OffsetMethodType='uniform' first so child rules unlock FirstHeight
    add_bl = wf.TaskObject["Add Boundary Layers"]
    add_bl.Arguments.set_state({
        "AddChild": "yes",
        "OffsetMethodType": "uniform",
    })
    rocket_labels = [lbl for lbl in verified_labels if "rocket_" in lbl]
    bl_state: dict[str, object] = {
        "AddChild": "yes",
        "BLControlName": "rocket_bl",
        "OffsetMethodType": "uniform",
        "FirstHeight": FIRST_LAYER_M,
        "NumberOfLayers": PRISM_LAYERS,
        "Rate": PRISM_GROWTH,
    }
    if rocket_labels:
        bl_state["FaceScope"] = {"GrowOn": "selected-labels"}
        bl_state["BlLabelList"] = rocket_labels
        print(f"[ork2cfd] Boundary layers scoped to rocket labels: {rocket_labels}")
    else:
        bl_state["FaceScope"] = {"GrowOn": "only-walls"}
    try:
        add_bl.Arguments.set_state(bl_state)
    except Exception as exc:
        print(f"[ork2cfd] Boundary layer state note ({exc}); setting uniform height with only-walls")
        add_bl.Arguments.set_state({
            "AddChild": "yes",
            "BLControlName": "rocket_bl",
            "OffsetMethodType": "uniform",
            "FirstHeight": FIRST_LAYER_M,
            "NumberOfLayers": PRISM_LAYERS,
            "Rate": PRISM_GROWTH,
            "FaceScope": {"GrowOn": "only-walls"},
        })
    add_bl.AddChildAndUpdate()
    add_bl.Execute()

    vol_mesh = wf.TaskObject["Generate the Volume Mesh"]
    vol_mesh.Arguments.set_state({"VolumeFill": "poly-hexcore"})
    if not vol_mesh.Execute():
        raise RuntimeError("Fluent Generate the Volume Mesh failed.")

    try:
        if vol_mesh.InsertNextTask(CommandName="ImproveVolumeMesh"):
            ivm = wf.TaskObject["Improve Volume Mesh"]
            ivm.Arguments.set_state({"CellQualityLimit": 0.15})
            ivm.Execute()
    except Exception as exc:
        print(f"[ork2cfd] Improve Volume Mesh note: {exc}")

    n_cells: int | None = None
    min_orth: float | None = None
    if mu is not None:
        try:
            n_cells = int(mu.get_cell_zone_count(cell_zone_name_pattern="*"))
            print(f"[ork2cfd] Volume mesh total cell count: {n_cells}")
        except Exception:
            pass
        try:
            q_res = mu.get_cell_quality_limits(cell_zone_name_pattern="*", measure="Orthogonal Quality")
            if isinstance(q_res, (int, float)) and 0.0 <= float(q_res) <= 1.0:
                min_orth = float(q_res)
            elif isinstance(q_res, (list, tuple)):
                for item in q_res:
                    if isinstance(item, (int, float)) and 0.0 <= float(item) <= 1.0:
                        min_orth = float(item)
                        break
            elif isinstance(q_res, dict):
                for key in ("min", "minimum", "Minimum", "min_quality"):
                    val = q_res.get(key)
                    if isinstance(val, (int, float)) and 0.0 <= float(val) <= 1.0:
                        min_orth = float(val)
                        break
        except Exception:
            pass
    if min_orth is not None and min_orth < 0.02:
        print(
            f"[ork2cfd] [WARN] Low orthogonal quality ({min_orth:.5f}); "
            "running extra mesh quality improvement pass..."
        )
        try:
            meshing_session.tui.mesh.modify.auto_node_move("*", "*", 0.05, 50, 120, "yes", 5)
            if mu is not None:
                q_res2 = mu.get_cell_quality_limits(
                    cell_zone_name_pattern="*", measure="Orthogonal Quality"
                )
                if isinstance(q_res2, (int, float)) and 0.0 <= float(q_res2) <= 1.0:
                    min_orth = float(q_res2)
                elif isinstance(q_res2, (list, tuple)):
                    for item in q_res2:
                        if isinstance(item, (int, float)) and 0.0 <= float(item) <= 1.0:
                            min_orth = float(item)
                            break
                elif isinstance(q_res2, dict):
                    for key in ("min", "minimum", "Minimum", "min_quality"):
                        val = q_res2.get(key)
                        if isinstance(val, (int, float)) and 0.0 <= float(val) <= 1.0:
                            min_orth = float(val)
                            break
            print(f"[ork2cfd] Post-smoothing min orthogonal quality: {min_orth}")
        except Exception as exc:
            print(f"[ork2cfd] Extra mesh smoothing note: {exc}")

    if MESH_FILE.exists():
        MESH_FILE.unlink()
    if hasattr(meshing_session, "file"):
        meshing_session.file.write_mesh(file_name=MESH_FILE.name)
    else:
        meshing_session.tui.file.write_mesh(MESH_FILE.name)
    print(f"[ork2cfd] Saved volume mesh: {MESH_FILE}")
    return n_cells, min_orth


def run_cfd(
    show_gui: bool = False,
    mach_list: list[float] | None = None,
    mesh_scale: float = 1.0,
) -> dict[str, object]:
    """Run Fluent Watertight Geometry meshing, physics setup, Mach sweep, and CSV/JSON export."""
    os.chdir(BASE_DIR)
    active_machs = [float(m) for m in (mach_list or MACH_LIST)]
    manifest = json.loads(MANIFEST_FILE.read_text(encoding="utf-8"))

    if IN_FLUENT_PY:
        meshing_session = globals()["meshing"]
        wf = globals()["workflow"]
        mesh_cells, min_orth = _run_meshing(
            meshing_session, wf, manifest, active_machs, mesh_scale=mesh_scale
        )
        solver_session = meshing_session.switch_to_solver()
        if solver_session is None:
            solver_session = globals().get("solver")
        return _configure_and_solve(
            solver_session,
            manifest,
            active_machs,
            mesh_cells=mesh_cells,
            min_orth_quality=min_orth,
            mesh_scale=mesh_scale,
        )

    import ansys.fluent.core as pyfluent

    print(f"[ork2cfd] Launching ANSYS Fluent {ANSYS_VERSION} Meshing ({CORES} cores)...")
    meshing_session = pyfluent.launch_fluent(
        version=ANSYS_VERSION,
        mode="meshing",
        precision="double",
        processor_count=CORES,
        show_gui=show_gui,
    )
    try:
        mesh_cells, min_orth = _run_meshing(
            meshing_session,
            meshing_session.workflow,
            manifest,
            active_machs,
            mesh_scale=mesh_scale,
        )
        solver_session = meshing_session.switch_to_solver()
        return _configure_and_solve(
            solver_session,
            manifest,
            active_machs,
            mesh_cells=mesh_cells,
            min_orth_quality=min_orth,
            mesh_scale=mesh_scale,
        )
    finally:
        try:
            meshing_session.exit()
        except Exception:
            pass


def _discover_solver_zones(sroot, manifest: dict) -> list[str]:
    """Return actual solver boundary zone names, falling back to manifest keys."""
    discovered: list[str] = []
    bcs = getattr(getattr(sroot, "setup", None), "boundary_conditions", None)
    if bcs is not None:
        for attr in ("wall", "pressure_far_field", "pressure_outlet", "velocity_inlet", "symmetry"):
            group = getattr(bcs, attr, None)
            if group is not None and hasattr(group, "get_object_names"):
                try:
                    for zn in group.get_object_names():
                        if zn not in discovered:
                            discovered.append(zn)
                except Exception:
                    pass
    if discovered:
        return discovered
    return list(manifest.get("named_selections_counts", {}).keys())


def _match_zones(all_zones: list[str], prefix: str) -> list[str]:
    """Match all boundary zone names belonging to a canonical ork2cfd Named Selection."""
    return sorted(
        z
        for z in all_zones
        if (
            z == prefix
            or z.startswith(f"{prefix}:")
            or z.startswith(f"{prefix}-")
            or z.startswith(f"{prefix}.")
        )
    )


def _split_nose_body_in_solver(
    sroot,
    solver_session,
    manifest: dict,
    solver_zones: list[str],
) -> list[str]:
    """Split tangent-continuous nosecone faces out of rocket_body in Solver if merged."""
    has_nose = any("rocket_nosecone" in z for z in solver_zones)
    body_hits = _match_zones(solver_zones, "rocket_body")
    if has_nose or not body_hits:
        return solver_zones

    m_faces = list(manifest.get("named_selections_faces", []) or [])
    nose_faces = [mf for mf in m_faces if mf.get("zone") == "rocket_nosecone"]
    if not nose_faces:
        return solver_zones

    nose_xmax = max(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[0]) for mf in nose_faces)
    nose_rmax = max(
        max(
            abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[1])),
            abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[1])),
            abs(float((mf.get("bbox_min_m") or [0.0, 0.0, 0.0])[2])),
            abs(float((mf.get("bbox_max_m") or [0.0, 0.0, 0.0])[2])),
        )
        for mf in nose_faces
    )
    if nose_xmax <= 0.0 or nose_rmax <= 0.0:
        return solver_zones

    try:
        reg_name = "ork2cfd_nose_clip"
        cregs = sroot.solution.cell_registers
        if reg_name not in cregs.get_object_names():
            reg = cregs.create(reg_name)
        else:
            reg = cregs[reg_name]
        reg.type.option = "hexahedron"
        r_lim = 2.5 * nose_rmax
        reg.type.hexahedron.min_point = [-0.1, -r_lim, -r_lim]
        reg.type.hexahedron.max_point = [nose_xmax + 1e-4, r_lim, r_lim]
        reg.type.hexahedron.inside = True

        body_zone = body_hits[0]
        solver_session.tui.mesh.modify_zones.sep_face_zone_mark(body_zone, reg_name, "yes")
        after_zones = _discover_solver_zones(sroot, manifest)
        new_zones = [z for z in after_zones if z not in solver_zones]
        if len(new_zones) == 1:
            solver_session.tui.mesh.modify_zones.zone_name(new_zones[0], "rocket_nosecone")
            updated = _discover_solver_zones(sroot, manifest)
            print(f"[ork2cfd] Split 'rocket_nosecone' from '{body_zone}' -> {updated}")
            return updated
        return after_zones
    except Exception as exc:
        print(f"[ork2cfd] Note: solver-mode nosecone/body split skipped ({exc})")
        return solver_zones


def _set_farfield_bc(sroot, solver_session, zname: str, mach_val: float, cos_a: float, sin_a: float) -> None:
    """Configure pressure-far-field conditions via Fluent settings API with dict/TUI fallback."""
    try:
        bc_s = sroot.setup.boundary_conditions.pressure_far_field[zname]
        bc_s.momentum.coordinate_system = "Cartesian (X, Y, Z)"
        bc_s.momentum.gauge_pressure.value = PRESSURE_PA
        bc_s.momentum.mach_number.value = mach_val
        if len(bc_s.momentum.flow_direction) != 3:
            bc_s.momentum.flow_direction.resize(3)
        bc_s.momentum.flow_direction[0].value = cos_a
        bc_s.momentum.flow_direction[1].value = sin_a
        bc_s.momentum.flow_direction[2].value = 0.0
        bc_s.thermal.temperature.value = TEMP_K
        bc_s.turbulence.turbulence_specification = "Intensity and Viscosity Ratio"
        bc_s.turbulence.turbulent_intensity = 0.01
        bc_s.turbulence.turbulent_viscosity_ratio = 5.0
        return
    except Exception as exc:
        print(f"[ork2cfd] Settings API pressure-far-field note for '{zname}' ({exc}); using TUI")
    solver_session.tui.define.boundary_conditions.pressure_far_field(
        zname, "no", PRESSURE_PA, "no", mach_val, "no", TEMP_K,
        "no", cos_a, "no", sin_a, "no", 0.0, "no", "no", "yes", "1", "5"
    )


def _export_contour_pngs(
    sroot,
    mach_val: float,
    symmetry_zones: list[str],
    slice_created: bool,
) -> tuple[str | None, str | None, bool]:
    """Safely render centerline Mach & Static Pressure contour PNGs for one Mach point."""
    mach_png_name = f"{ROCKET_STEM}_M{mach_val:.2f}_mach.png"
    pres_png_name = f"{ROCKET_STEM}_M{mach_val:.2f}_pressure.png"
    out_mach: str | None = None
    out_pres: str | None = None

    try:
        surf_name = symmetry_zones[0] if symmetry_zones else "ork2cfd_centerline_xy"
        if not symmetry_zones and not slice_created:
            planes = sroot.results.surfaces.plane_surface
            if surf_name not in planes.get_object_names():
                pl = planes.create(surf_name)
                pl.method = "xy-plane"
                pl.z = 0.0
            slice_created = True

        gfx = sroot.results.graphics
        try:
            gfx.picture.driver_options.hardcopy_format = "png"
            gfx.picture.x_resolution = 1600
            gfx.picture.y_resolution = 900
        except Exception:
            pass
        for field_name, tag, png_name in (
            ("mach-number", "ork2cfd_mach", mach_png_name),
            ("pressure", "ork2cfd_pressure", pres_png_name),
        ):
            try:
                contours = gfx.contour
                c_obj = contours[tag] if tag in contours.get_object_names() else contours.create(tag)
                c_obj.field = field_name
                resolved_surf = surf_name
                if hasattr(c_obj.surfaces_list, "allowed_values"):
                    allowed = [str(v) for v in (c_obj.surfaces_list.allowed_values() or [])]
                    alt_name = surf_name.replace(".", "-")
                    if surf_name in allowed:
                        resolved_surf = surf_name
                    elif alt_name in allowed:
                        resolved_surf = alt_name
                    elif symmetry_zones:
                        sym_hit = next((v for v in allowed if "symmetry" in v.lower()), None)
                        if sym_hit is not None:
                            resolved_surf = sym_hit
                    if resolved_surf not in allowed:
                        planes = sroot.results.surfaces.plane_surface
                        fallback_plane = "ork2cfd_centerline_xy"
                        if fallback_plane not in planes.get_object_names():
                            pl = planes.create(fallback_plane)
                            pl.method = "xy-plane"
                            pl.z = 0.0
                        slice_created = True
                        resolved_surf = fallback_plane
                c_obj.surfaces_list = [resolved_surf]
                c_obj.display()
                try:
                    gfx.views.restore_view("front")
                except Exception:
                    pass
                try:
                    gfx.views.auto_scale()
                except Exception:
                    pass
                gfx.picture.save_picture(file_name=png_name)
                p = BASE_DIR / png_name
                if p.exists() and p.stat().st_size > 0:
                    if tag == "ork2cfd_mach":
                        out_mach = png_name
                    else:
                        out_pres = png_name
            except Exception as inner_exc:
                print(f"[ork2cfd] Contour export '{png_name}' note: {inner_exc}")
    except Exception as exc:
        print(f"[ork2cfd] Contour export skipped: {exc}")

    return out_mach, out_pres, slice_created


def _clear_cd_convergence(sroot) -> None:
    """Remove any prior cd_total convergence condition so low-CFL warmup is not halted early."""
    try:
        conv_reps = sroot.solution.monitor.convergence_conditions.convergence_reports
        existing = list(conv_reps.get_object_names() or [])
        if "cd_total_conv" in existing:
            conv_reps.delete(["cd_total_conv"])
    except Exception:
        pass


def _configure_cd_convergence(sroot, max_iters: int) -> None:
    """Configure early solver convergence stop when cd_total stabilizes within 1e-4 over 25 iters."""
    ignore_iters = min(CD_STOP_IGNORE_INITIAL, max(10, max_iters // 5))
    window_iters = min(CD_STOP_WINDOW, max(5, max_iters // 4))
    cname = "cd_total_conv"
    try:
        conv_cond = sroot.solution.monitor.convergence_conditions
        conv_reps = conv_cond.convergence_reports
        existing = list(conv_reps.get_object_names() or [])
        if cname in existing:
            conv_reps.delete([cname])

        c_obj = conv_reps.create(cname)
        c_obj.report_defs = "cd_total"
        c_obj.stop_criterion = CD_STOP_CRITERION
        c_obj.previous_values_to_consider = window_iters
        c_obj.initial_values_to_ignore = ignore_iters
        c_obj.active = True
        c_obj.print = True

        conv_cond.frequency = 1
        allowed_conds = (
            list(conv_cond.condition.allowed_values())
            if hasattr(conv_cond.condition, "allowed_values")
            else []
        )
        cond_choice = next(
            (str(v) for v in allowed_conds if "any" in str(v).lower()),
            "any-condition-is-met",
        )
        conv_cond.condition = cond_choice

        res_opts = sroot.solution.monitor.residual.options
        allowed_crit = (
            list(res_opts.criterion_type.allowed_values())
            if hasattr(res_opts.criterion_type, "allowed_values")
            else []
        )
        if not allowed_crit or "none" in [str(v) for v in allowed_crit]:
            res_opts.criterion_type = "none"

        print(
            f"[ork2cfd] Configured cd_total convergence condition "
            f"(stop_criterion={CD_STOP_CRITERION:.1e}, window={window_iters}, "
            f"ignore_first={ignore_iters}, condition={cond_choice})"
        )
    except Exception as exc:
        print(f"[ork2cfd] Note: cd_total convergence condition skipped ({exc})")


def _set_courant_number(sroot, solver_session, active_solver: str, cfl: float) -> None:
    """Safely configure solver Courant number via settings API or TUI."""
    if active_solver == "density-based":
        try:
            sroot.solution.controls.courant_number = float(cfl)
            return
        except Exception:
            pass
        try:
            solver_session.tui.solve.set.courant_number(float(cfl))
        except Exception as exc:
            print(f"[ork2cfd] Density-based CFL note: {exc}")
    else:
        try:
            sroot.solution.controls.courant_number = float(cfl)
            return
        except Exception:
            pass
        try:
            sroot.solution.controls.pseudo_time_method.time_step_factor = float(cfl)
        except Exception:
            pass


def _configure_solver_numerics(
    sroot,
    solver_session,
    active_solver: str,
    mach_val: float,
    use_compressible: bool,
) -> int:
    """Apply compressible/supersonic stabilization and return low-CFL warmup iterations."""
    if active_solver == "density-based":
        flux_set = False
        try:
            sroot.solution.methods.flux_type = "AUSM"
            flux_set = True
        except Exception:
            pass
        if not flux_set:
            try:
                solver_session.tui.solve.set.flux_type("ausm")
                flux_set = True
            except Exception as exc:
                print(f"[ork2cfd] AUSM flux note: {exc}")
        _set_courant_number(sroot, solver_session, active_solver, 0.5)
        warmup = min(40, max(15, ITERATIONS // 6))
        print(
            f"[ork2cfd] Density-based supersonic stabilization: "
            f"flux={'AUSM' if flux_set else 'default'}, initial CFL=0.5, warmup={warmup} iters"
        )
        return warmup

    if use_compressible and mach_val >= 1.0:
        try:
            sroot.solution.methods.high_speed_numerics.enabled = True
            print("[ork2cfd] Enabled compressible High-Speed Numerics (pressure-based coupled).")
        except Exception:
            pass
        _set_courant_number(sroot, solver_session, active_solver, min(5.0, COURANT_NUMBER))
        return min(30, max(10, ITERATIONS // 8))

    return 0


def _initialize_flow(
    sroot,
    solver_session,
    pff_zones: list[str],
    mach_val: float,
    use_compressible: bool,
) -> None:
    """Use uniform farfield initialization for supersonic flows; hybrid for subsonic/transonic."""
    if use_compressible and mach_val >= 1.0 and pff_zones:
        try:
            init_obj = sroot.solution.initialization
            init_obj.initialization_type = "standard"
            if hasattr(init_obj, "compute_defaults"):
                init_obj.compute_defaults(from_zone=pff_zones[0])
            else:
                solver_session.tui.solve.initialize.compute_defaults.pressure_far_field(pff_zones[0])
            init_obj.standard_initialize()
            print(f"[ork2cfd] Initialized supersonic flow from farfield '{pff_zones[0]}'.")
            return
        except Exception as exc:
            print(f"[ork2cfd] Standard farfield init fallback to hybrid ({exc})")
    solver_session.tui.solve.initialize.hyb_initialization()


def _configure_and_solve(
    solver_session,
    manifest: dict,
    mach_list: list[float],
    mesh_cells: int | None = None,
    min_orth_quality: float | None = None,
    mesh_scale: float = 1.0,
) -> dict[str, object]:
    """Apply regime physics, boundary conditions, Mach sweep solve, and CSV/JSON output."""
    sroot = getattr(solver_session, "settings", solver_session)
    aoa_rad = math.radians(AOA_DEG)
    cos_a = math.cos(aoa_rad)
    sin_a = math.sin(aoa_rad)
    use_compressible = {{ "True" if solver_rec.energy_enabled else "False" }} or any(
        m >= 0.3 for m in mach_list
    )
    mixed_sweep = len(mach_list) > 1 and any(m < 1.2 for m in mach_list)
    active_solver = "pressure-based" if mixed_sweep else SOLVER_TYPE

    if active_solver == "density-based":
        solver_session.tui.define.models.solver.density_based_implicit("yes")
    else:
        solver_session.tui.define.models.solver.pressure_based("yes")
        try:
            sroot.solution.methods.p_v_coupling.flow_scheme = "Coupled"
        except Exception as exc:
            print(f"[ork2cfd] Coupled scheme note: {exc}")

    if use_compressible:
        sroot.setup.models.energy.enabled = True
        try:
            air = sroot.setup.materials.fluid["air"]
            air.density.option = "ideal-gas"
            air.viscosity.option = "sutherland"
        except Exception:
            solver_session.tui.define.materials.change_create(
                "air", "air", "yes", "ideal-gas", "no", "no", "yes", "sutherland",
                "three-coefficient-method", "1.716e-05", "273.15", "110.4", "no", "no", "no"
            )
        solver_session.tui.define.operating_conditions.operating_pressure(0.0)
    else:
        sroot.setup.materials.fluid["air"].density.value = DENSITY_KG_M3
        sroot.setup.materials.fluid["air"].viscosity.value = VISCOSITY_PA_S
        solver_session.tui.define.operating_conditions.operating_pressure(PRESSURE_PA)

    sroot.setup.models.viscous.model = "k-omega"
    sroot.setup.models.viscous.k_omega_model = "sst"

    solver_session.tui.report.reference_values.area(S_REF_M2 / SYM_FACTOR)
    solver_session.tui.report.reference_values.length(L_REF_M)
    solver_session.tui.report.reference_values.density(DENSITY_KG_M3)
    solver_session.tui.report.reference_values.viscosity(VISCOSITY_PA_S)
    solver_session.tui.report.reference_values.temperature(TEMP_K)

    solver_zones = _discover_solver_zones(sroot, manifest)
    solver_zones = _split_nose_body_in_solver(sroot, solver_session, manifest, solver_zones)
    print(f"[ork2cfd] Active solver boundary zones: {solver_zones}")

    farfield_bc = "pressure-far-field" if use_compressible else "{{ solver_rec.farfield_bc_type }}"
    outlet_bc = "pressure-far-field" if use_compressible else "{{ solver_rec.outlet_bc_type }}"

    farfield_zones = _match_zones(solver_zones, "farfield")
    inlet_zones = _match_zones(solver_zones, "inlet")
    outlet_zones = _match_zones(solver_zones, "outlet")
    symmetry_zones = _match_zones(solver_zones, "symmetry")

    pff_zones = (farfield_zones + inlet_zones) if farfield_bc == "pressure-far-field" else []
    if outlet_bc == "pressure-far-field":
        pff_zones.extend(outlet_zones)
    vinlet_zones = (
        sorted(set(inlet_zones + farfield_zones))
        if farfield_bc != "pressure-far-field"
        else []
    )

    for zname in pff_zones:
        solver_session.tui.define.boundary_conditions.zone_type(zname, "pressure-far-field")
    for zname in vinlet_zones:
        solver_session.tui.define.boundary_conditions.zone_type(zname, "velocity-inlet")
    if outlet_bc == "pressure-outlet":
        for zname in outlet_zones:
            solver_session.tui.define.boundary_conditions.zone_type(zname, "pressure-outlet")
    for zname in symmetry_zones:
        solver_session.tui.define.boundary_conditions.zone_type(zname, "symmetry")

    manifest_rocket = sorted(
        z for z in manifest.get("named_selections_counts", {}) if z.startswith("rocket_")
    )
    rocket_groups: dict[str, list[str]] = {}
    for prefix in manifest_rocket:
        hits = _match_zones(solver_zones, prefix)
        if hits:
            rocket_groups[prefix] = hits
    if not rocket_groups:
        fallback_rocket = sorted(z for z in solver_zones if "rocket_" in z)
        for zname in fallback_rocket:
            rocket_groups[zname] = [zname]
    all_rocket_zones = sorted({z for zs in rocket_groups.values() for z in zs})

    report_names: list[str] = []
    if all_rocket_zones:
        rdefs = sroot.solution.report_definitions
        for grp_name, zlist in rocket_groups.items():
            dname = f"cd_{grp_name}"
            fname = f"fn_{grp_name}"
            d_obj = rdefs.drag.create(dname)
            d_obj.zones = zlist
            d_obj.force_vector = [cos_a, sin_a, 0.0]
            f_obj = rdefs.force.create(fname)
            f_obj.zones = zlist
            f_obj.force_vector = [cos_a, sin_a, 0.0]
            report_names.extend([dname, fname])
        dtot = rdefs.drag.create("cd_total")
        dtot.zones = all_rocket_zones
        dtot.force_vector = [cos_a, sin_a, 0.0]
        ftot = rdefs.force.create("fn_total")
        ftot.zones = all_rocket_zones
        ftot.force_vector = [cos_a, sin_a, 0.0]
        report_names.extend(["cd_total", "fn_total"])
        try:
            yplus_rep = rdefs.surface.create("wall_yplus_avg")
            yplus_rep.report_type = "surface-areaavg"
            allowed_yp = (
                list(yplus_rep.field.allowed_values())
                if hasattr(yplus_rep.field, "allowed_values")
                else []
            )
            yplus_rep.field = (
                "y-plus" if ("y-plus" in allowed_yp or not allowed_yp) else "wall-yplus"
            )
            yplus_rep.surface_names = all_rocket_zones
            report_names.append("wall_yplus_avg")
        except Exception as exc:
            print(f"[ork2cfd] Note: y+ report definition skipped ({exc})")

    aero_rows: list[list[object]] = []
    rocketpy_rows: list[list[object]] = []
    summary_runs: list[dict[str, object]] = []
    slice_created = False

    for idx, mach_val in enumerate(mach_list):
        vel = mach_val * SOUND_SPEED_M_S
        q_dyn = 0.5 * DENSITY_KG_M3 * vel * vel
        solver_session.tui.report.reference_values.velocity(vel)

        for zname in pff_zones:
            _set_farfield_bc(sroot, solver_session, zname, mach_val, cos_a, sin_a)
        for zname in vinlet_zones:
            solver_session.tui.define.boundary_conditions.velocity_inlet(
                zname, "no", "no", "yes", "yes", "no", vel, "no", 0,
                "no", cos_a, "no", sin_a, "no", 0.0, "no", "no", "yes", "5", "10"
            )

        if idx == 0 or (mach_val < 1.0) != (mach_list[idx - 1] < 1.0):
            _initialize_flow(sroot, solver_session, pff_zones, mach_val, use_compressible)
        warmup_iters = _configure_solver_numerics(
            sroot, solver_session, active_solver, mach_val, use_compressible
        )
        if warmup_iters > 0 and ITERATIONS > warmup_iters:
            _clear_cd_convergence(sroot)
            solver_session.tui.solve.iterate(warmup_iters)
            _set_courant_number(sroot, solver_session, active_solver, COURANT_NUMBER)
            if "cd_total" in report_names:
                _configure_cd_convergence(sroot, ITERATIONS)
            solver_session.tui.solve.iterate(ITERATIONS - warmup_iters)
        else:
            if "cd_total" in report_names:
                _configure_cd_convergence(sroot, ITERATIONS)
            solver_session.tui.solve.iterate(ITERATIONS)

        mach_case = BASE_DIR / f"{ROCKET_STEM}_M{mach_val:.2f}.cas.h5"
        mach_data = BASE_DIR / f"{ROCKET_STEM}_M{mach_val:.2f}.dat.h5"
        if mach_case.exists():
            mach_case.unlink()
        if mach_data.exists():
            mach_data.unlink()
        solver_session.tui.file.write_case_data(mach_case.name)

        saved_case_name = mach_case.name
        saved_data_name = mach_data.name
        if len(mach_list) == 1 or abs(mach_val - MACH) < 1e-6:
            if CASE_FILE.exists():
                CASE_FILE.unlink()
            if DATA_FILE.exists():
                DATA_FILE.unlink()
            solver_session.tui.file.write_case_data(CASE_FILE.name)
            saved_case_name = CASE_FILE.name
            saved_data_name = DATA_FILE.name
            print(f"[ork2cfd] Solved and saved case/data: {CASE_FILE}")

        computed = {}
        yplus_val: float | None = None
        if report_names:
            computed = sroot.solution.report_definitions.compute(report_defs=report_names)
            print(f"[ork2cfd] Mach {mach_val:.2f} reports:", computed)
            yplus_val = _extract_computed_scalar(computed, "wall_yplus_avg")
            if yplus_val is not None:
                print(f"[ork2cfd] Mach {mach_val:.2f} wall_yplus_avg = {yplus_val:.4f}")

        zone_drag_sum = 0.0
        zones_summary: list[dict[str, object]] = []
        for grp_name in rocket_groups:
            raw_f = _extract_computed_scalar(computed, f"fn_{grp_name}")
            raw_cd = _extract_computed_scalar(computed, f"cd_{grp_name}")
            drag_n = (raw_f * SYM_FACTOR) if raw_f is not None else 0.0
            if raw_cd is not None:
                cd_z = raw_cd
            else:
                cd_z = (drag_n / (q_dyn * S_REF_M2)) if (q_dyn * S_REF_M2) > 0.0 else 0.0
            zone_drag_sum += drag_n
            aero_rows.append([
                ROCKET_NAME, mach_val, ALTITUDE_M, AOA_DEG, grp_name,
                f"{drag_n:.6f}", f"{cd_z:.6f}",
            ])
            zones_summary.append({
                "zone": grp_name,
                "drag_force_n": round(drag_n, 6),
                "cd": round(cd_z, 6),
            })

        tot_raw_f = _extract_computed_scalar(computed, "fn_total")
        tot_raw_cd = _extract_computed_scalar(computed, "cd_total")
        tot_drag_n = (tot_raw_f * SYM_FACTOR) if tot_raw_f is not None else zone_drag_sum
        if tot_raw_cd is not None:
            tot_cd = tot_raw_cd
        else:
            tot_cd = (tot_drag_n / (q_dyn * S_REF_M2)) if (q_dyn * S_REF_M2) > 0.0 else 0.0
        aero_rows.append([
            ROCKET_NAME, mach_val, ALTITUDE_M, AOA_DEG, "total",
            f"{tot_drag_n:.6f}", f"{tot_cd:.6f}",
        ])
        rocketpy_rows.append([mach_val, f"{tot_cd:.6f}"])

        mach_png, pres_png, slice_created = _export_contour_pngs(
            sroot, mach_val, symmetry_zones, slice_created
        )
        is_diverged = (
            (not math.isfinite(tot_cd))
            or tot_cd <= 0.01
            or tot_cd > 8.0
            or (
                yplus_val is not None
                and ((not math.isfinite(yplus_val)) or yplus_val <= 0.0 or yplus_val > 2500.0)
            )
        )
        summary_runs.append({
            "mach": mach_val,
            "velocity_m_s": round(vel, 4),
            "total_cd": round(tot_cd, 6),
            "total_drag_n": round(tot_drag_n, 6),
            "wall_yplus_avg": round(yplus_val, 4) if yplus_val is not None else None,
            "diverged": is_diverged,
            "case_file": saved_case_name if (BASE_DIR / saved_case_name).exists() else mach_case.name,
            "data_file": saved_data_name if (BASE_DIR / saved_data_name).exists() else mach_data.name,
            "mach_contour_png": mach_png,
            "pressure_contour_png": pres_png,
            "zones": zones_summary,
        })

    with RESULTS_CSV.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["rocket", "mach", "altitude_m", "aoa_deg", "zone", "drag_force_n", "cd"])
        writer.writerows(aero_rows)

    with ROCKETPY_CSV.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["mach", "cd"])
        writer.writerows(rocketpy_rows)

    summary_payload = {
        "rocket_name": ROCKET_NAME,
        "stem": ROCKET_STEM,
        "altitude_m": ALTITUDE_M,
        "aoa_deg": AOA_DEG,
        "sym_factor": SYM_FACTOR,
        "s_ref_m2": S_REF_M2,
        "mesh_scale": round(float(mesh_scale), 6),
        "mesh_cells": mesh_cells,
        "min_orth_quality": round(min_orth_quality, 5) if min_orth_quality is not None else None,
        "runs": summary_runs,
    }
    SUMMARY_JSON.write_text(json.dumps(summary_payload, indent=2), encoding="utf-8")
    print(f"[ork2cfd] Wrote {RESULTS_CSV.name}, {ROCKETPY_CSV.name}, and {SUMMARY_JSON.name}")
    return summary_payload


def _run_standalone_mesh_convergence(
    show_gui: bool = False,
    mach_list: list[float] | None = None,
    tol: float = MESH_CONV_REL_TOL,
) -> None:
    """Run progressive coarse-to-fine PyFluent sessions until |ΔCd|/Cd <= tol."""
    preset_fmax = {"coarse": 0.140, "student_safe": 0.110, "standard": 0.085, "fine": 0.045}
    base_f = preset_fmax.get(MESH_PRESET, 0.085)
    start_scale = max(1.0, preset_fmax["coarse"] / base_f)
    scales = [round(start_scale / (MESH_CONV_FACTOR ** i), 6) for i in range(max(2, MESH_CONV_MAX_LEVELS))]
    prev_cd: float | None = None
    for idx, scale in enumerate(scales, start=1):
        print(f"[ork2cfd] Mesh Convergence Level {idx}/{len(scales)} (mesh_scale={scale:.4f})...")
        summary = run_cfd(show_gui=show_gui, mach_list=mach_list, mesh_scale=scale)
        runs = summary.get("runs") or []
        curr_cd = float(runs[0]["total_cd"]) if runs else None
        cells = summary.get("mesh_cells")
        if prev_cd is not None and curr_cd is not None:
            rel_chg = abs(curr_cd - prev_cd) / max(abs(curr_cd), 1e-9)
            print(f"[ork2cfd] Level {idx}: cells={cells}, Cd={curr_cd:.6f}, ΔCd={rel_chg * 100.0:.3f}%")
            if rel_chg <= tol:
                print(f"[ork2cfd] Mesh converged within {tol * 100.0:.2f}% at level {idx}.")
                break
        else:
            print(f"[ork2cfd] Level {idx}: cells={cells}, Cd={curr_cd}")
        prev_cd = curr_cd


if IN_FLUENT_PY:
    import sys

    _run_failed = False
    try:
        _env_machs = os.environ.get("ORK2CFD_MACH_LIST", "").strip()
        _parsed_machs = [float(x) for x in _env_machs.split(",") if x.strip()] if _env_machs else None
        _env_scale = os.environ.get("ORK2CFD_MESH_SCALE", "").strip()
        _parsed_scale = float(_env_scale) if _env_scale else 1.0
        run_cfd(show_gui=False, mach_list=_parsed_machs, mesh_scale=_parsed_scale)
    except Exception:
        import traceback

        _run_failed = True
        traceback.print_exc()
        sys.stdout.flush()
        sys.stderr.flush()
        raise
    finally:
        if _run_failed:
            sys.exit(1)
        exit()
elif __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run ork2cfd Fluent CFD workflow")
    parser.add_argument("--mach", nargs="+", type=float, default=None, help="Mach number list")
    parser.add_argument("--gui", action="store_true", help="Show Fluent GUI during run")
    parser.add_argument(
        "--mesh-scale",
        type=float,
        default=None,
        help="Single-run spatial mesh element scale multiplier (keeps y+ Δy1 fixed)",
    )
    parser.add_argument(
        "--mesh-conv",
        action=argparse.BooleanOptionalAction,
        default=MESH_CONV_ENABLED,
        help="Run progressive coarse-to-fine grid-independence loop until Cd stabilizes",
    )
    parser.add_argument(
        "--mesh-tol",
        type=float,
        default=MESH_CONV_REL_TOL,
        help="Relative Cd convergence tolerance (fraction, e.g. 0.01 = 1%%)",
    )
    cli_args = parser.parse_args()
    if cli_args.mesh_scale is not None:
        run_cfd(show_gui=cli_args.gui, mach_list=cli_args.mach, mesh_scale=cli_args.mesh_scale)
    elif cli_args.mesh_conv:
        _run_standalone_mesh_convergence(
            show_gui=cli_args.gui, mach_list=cli_args.mach, tol=cli_args.mesh_tol
        )
    else:
        run_cfd(show_gui=cli_args.gui, mach_list=cli_args.mach)
