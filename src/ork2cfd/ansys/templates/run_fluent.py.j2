"""Standalone PyFluent end-to-end Watertight Meshing & Solver script generated by ork2cfd."""

from __future__ import annotations

import argparse
import csv
import json
import math
import re
from pathlib import Path

import ansys.fluent.core as pyfluent

BASE_DIR = Path(__file__).resolve().parent
STEP_FILE = BASE_DIR / "{{ step_filename }}"
MANIFEST_FILE = BASE_DIR / "{{ manifest_filename }}"
MESH_FILE = BASE_DIR / "{{ stem }}.msh.h5"
CASE_FILE = BASE_DIR / "{{ stem }}.cas.h5"
DATA_FILE = BASE_DIR / "{{ stem }}.dat.h5"
RESULTS_CSV = BASE_DIR / "aero_results.csv"
ROCKETPY_CSV = BASE_DIR / "rocketpy_drag.csv"

# Rocket & Flight Configuration (pre-computed by ork2cfd)
ROCKET_NAME = "{{ rocket.name }}"
ANSYS_VERSION = "{{ ansys_version }}"
CORES = {{ flight.cores }}
MACH = {{ flight.mach }}
MACH_LIST = [{{ flight.mach }}]
ALTITUDE_M = {{ flight.altitude_m }}
AOA_DEG = {{ flight.aoa_deg }}
REGIME = "{{ solver_rec.regime.value }}"
SOLVER_TYPE = "{{ solver_rec.solver_type }}"
ITERATIONS = {{ flight.iterations }}
SYM_FACTOR = {{ symmetry_multiplier }}

# Reference Values
S_REF_M2 = {{ "%.8f" | format(rocket.reference_area) }}
L_REF_M = {{ "%.6f" | format(rocket.total_length) }}
D_REF_M = {{ "%.6f" | format(rocket.max_diameter) }}

# ISA Atmosphere & Boundary Layer Mesh Sizing
PRESSURE_PA = {{ "%.4f" | format(bl.atmosphere.pressure_pa) }}
TEMP_K = {{ "%.4f" | format(bl.atmosphere.temperature_k) }}
DENSITY_KG_M3 = {{ "%.6f" | format(bl.atmosphere.density_kg_m3) }}
VISCOSITY_PA_S = {{ "%.8e" | format(bl.atmosphere.viscosity_pa_s) }}
SOUND_SPEED_M_S = {{ "%.4f" | format(bl.atmosphere.speed_of_sound_m_s) }}
VELOCITY_M_S = {{ "%.4f" | format(bl.velocity_m_s) }}
ROUGHNESS_KS_M = {{ "%.8e" | format(solver_rec.roughness_height_m) }}

SURF_MIN_M = {{ "%.6f" | format(bl.surface_min_size_m) }}
SURF_MAX_M = {{ "%.6f" | format(bl.surface_max_size_m) }}
FIN_FACE_SIZE_M = {{ "%.6f" | format(fin_face_size_m) }}
NOSE_FACE_SIZE_M = {{ "%.6f" | format(nose_face_size_m) }}
BOI_NF_SIZE_M = {{ "%.6f" | format(bl.boi_nearfield_size_m) }}
BOI_WAKE_SIZE_M = {{ "%.6f" | format(bl.boi_wake_size_m) }}
FIRST_LAYER_M = {{ "%.8e" | format(bl.first_layer_thickness_m) }}
PRISM_LAYERS = {{ bl.prism_layers }}
PRISM_GROWTH = {{ bl.prism_growth_rate }}


def _apply_local_sizing(wf) -> None:
    """Apply local face sizing on fins/nosecone and Body-of-Influence sizing controls."""
    add_sizing = wf.TaskObject["Add Local Sizing"]
    controls = [
        ("fin_face_sizing", "Face Size", FIN_FACE_SIZE_M, ["rocket_fins"]),
        ("nose_face_sizing", "Face Size", NOSE_FACE_SIZE_M, ["rocket_nosecone"]),
        ("boi_nearfield_sizing", "Body Of Influence", BOI_NF_SIZE_M, ["boi_nearfield"]),
        ("boi_wake_sizing", "Body Of Influence", BOI_WAKE_SIZE_M, ["boi_wake"]),
    ]
    for ctrl_name, exec_mode, size_m, labels in controls:
        try:
            add_sizing.Arguments.set_state({
                "AddChild": "yes",
                "BOIControlName": ctrl_name,
                "BOIExecution": exec_mode,
                "BOISize": size_m,
                "BOIFaceLabelList": labels,
            })
            add_sizing.AddChildAndUpdate()
        except Exception as exc:
            print(f"[ork2cfd] Local sizing '{ctrl_name}' skipped: {exc}")
    add_sizing.Execute()


def _parse_total_force_n(report_obj) -> float:
    """Extract net aerodynamic force (N) from Fluent wall_forces TUI output."""
    text = str(report_obj or "")
    for line in reversed(text.splitlines()):
        low = line.lower()
        if "net" in low or "total" in low:
            nums = re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", line)
            if nums:
                return float(nums[-1])
    nums = re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", text)
    return float(nums[-1]) if nums else 0.0


def run_cfd(show_gui: bool = False, mach_list: list[float] | None = None) -> None:
    """Run Fluent Watertight Geometry meshing, physics setup, Mach sweep, and CSV export."""
    active_machs = [float(m) for m in (mach_list or MACH_LIST)]
    manifest = json.loads(MANIFEST_FILE.read_text(encoding="utf-8"))
    print(f"[ork2cfd] Launching ANSYS Fluent {ANSYS_VERSION} Meshing ({CORES} cores)...")

    meshing = pyfluent.launch_fluent(
        version=ANSYS_VERSION,
        mode="meshing",
        precision="double",
        processor_count=CORES,
        show_gui=show_gui,
    )

    try:
        wf = meshing.workflow
        wf.InitializeWorkflow(WorkflowType="Watertight Geometry")

        import_geo = wf.TaskObject["Import Geometry"]
        import_geo.Arguments.set_state({
            "FileName": str(STEP_FILE),
            "LengthUnit": "m",
            "ImportCadPreferences": {
                "ReadNamedSelections": True,
            },
        })
        import_geo.Execute()

        _apply_local_sizing(wf)

        surf_mesh = wf.TaskObject["Generate the Surface Mesh"]
        surf_mesh.Arguments.set_state({
            "CFDSurfaceMeshControls": {
                "MinSize": SURF_MIN_M,
                "MaxSize": SURF_MAX_M,
                "GrowthRate": 1.2,
                "CurvatureNormalAngle": 12.0,
            }
        })
        surf_mesh.Execute()

        desc_geo = wf.TaskObject["Describe Geometry"]
        desc_geo.UpdateChildTasks(SetupTypeChanged=True)
        desc_geo.Arguments.set_state({
            "SetupType": "The geometry consists of only fluid regions",
            "CappingRequired": "No",
        })
        desc_geo.UpdateChildTasks(SetupTypeChanged=True)
        desc_geo.Execute()

        wf.TaskObject["Update Boundaries"].Execute()
        wf.TaskObject["Create Regions"].Execute()
        wf.TaskObject["Update Regions"].Execute()

        add_bl = wf.TaskObject["Add Boundary Layers"]
        try:
            add_bl.Arguments.set_state({
                "OffsetMethodType": "uniform",
                "FirstHeight": FIRST_LAYER_M,
                "NumberOfLayers": PRISM_LAYERS,
                "Rate": PRISM_GROWTH,
            })
        except Exception:
            pass
        add_bl.AddChildAndUpdate()
        add_bl.Execute()

        vol_mesh = wf.TaskObject["Generate the Volume Mesh"]
        vol_mesh.Arguments.set_state({"VolumeFill": "poly-hexcore"})
        vol_mesh.Execute()

        meshing.file.write_mesh(file_name=str(MESH_FILE))
        print(f"[ork2cfd] Saved volume mesh: {MESH_FILE}")

        solver = meshing.switch_to_solver()
        _configure_and_solve(solver, manifest, active_machs)
    finally:
        try:
            meshing.exit()
        except Exception:
            pass


def _configure_and_solve(solver, manifest: dict, mach_list: list[float]) -> None:
    """Apply regime physics, boundary conditions, Mach sweep solve, and CSV output."""
    aoa_rad = math.radians(AOA_DEG)
    cos_a = math.cos(aoa_rad)
    sin_a = math.sin(aoa_rad)

    if SOLVER_TYPE == "density-based":
        solver.tui.define.models.solver.density_based_implicit("yes")
    else:
        solver.tui.define.models.solver.pressure_based("yes")

    if {{ "True" if solver_rec.energy_enabled else "False" }}:
        solver.setup.models.energy.enabled = True
        solver.tui.define.materials.change_create(
            "air", "air", "yes", "ideal-gas", "no", "no", "yes", "sutherland",
            "three-coefficient-method", "1.716e-05", "273.15", "110.4", "no", "no", "no"
        )
    else:
        solver.setup.materials.fluid["air"].density.value = DENSITY_KG_M3
        solver.setup.materials.fluid["air"].viscosity.value = VISCOSITY_PA_S

    solver.setup.models.viscous.model = "k-omega"
    solver.setup.models.viscous.k_omega_model = "sst"

    if {{ "True" if solver_rec.energy_enabled else "False" }}:
        solver.tui.define.operating_conditions.operating_pressure(0.0)
    else:
        solver.tui.define.operating_conditions.operating_pressure(PRESSURE_PA)

    solver.tui.report.reference_values.area(S_REF_M2 / SYM_FACTOR)
    solver.tui.report.reference_values.length(L_REF_M)
    solver.tui.report.reference_values.density(DENSITY_KG_M3)
    solver.tui.report.reference_values.viscosity(VISCOSITY_PA_S)
    solver.tui.report.reference_values.temperature(TEMP_K)

    zones = manifest.get("named_selections_counts", {})
    for zname in zones:
        if zname in ("farfield", "inlet") and "{{ solver_rec.farfield_bc_type }}" == "pressure-far-field":
            solver.tui.define.boundary_conditions.zone_type(zname, "pressure-far-field")
        elif zname == "inlet":
            solver.tui.define.boundary_conditions.zone_type(zname, "velocity-inlet")
        elif zname == "outlet" and "{{ solver_rec.outlet_bc_type }}" == "pressure-outlet":
            solver.tui.define.boundary_conditions.zone_type(zname, "pressure-outlet")
        elif zname == "symmetry":
            solver.tui.define.boundary_conditions.zone_type(zname, "symmetry")

    rocket_zones = sorted(z for z in zones if z.startswith("rocket_"))
    aero_rows: list[list[object]] = []
    rocketpy_rows: list[list[object]] = []

    for idx, mach_val in enumerate(mach_list):
        vel = mach_val * SOUND_SPEED_M_S
        q_dyn = 0.5 * DENSITY_KG_M3 * vel * vel
        solver.tui.report.reference_values.velocity(vel)

        for zname in zones:
            if zname in ("farfield", "inlet") and "{{ solver_rec.farfield_bc_type }}" == "pressure-far-field":
                solver.tui.define.boundary_conditions.pressure_far_field(
                    zname, "no", PRESSURE_PA, "no", mach_val, "no", TEMP_K,
                    "no", cos_a, "no", sin_a, "no", 0.0, "no", "no", "yes", "5", "10"
                )
            elif zname == "inlet":
                solver.tui.define.boundary_conditions.velocity_inlet(
                    zname, "no", "no", "yes", "yes", "no", vel, "no", 0,
                    "no", cos_a, "no", sin_a, "no", 0.0, "no", "no", "yes", "5", "10"
                )

        if idx == 0:
            solver.solution.initialization.hybrid_initialize()
        solver.solution.run_calculation.iterate(iter_count=ITERATIONS)

        mach_case = BASE_DIR / f"{{ stem }}_M{mach_val:.2f}.cas.h5"
        solver.file.write(file_type="case-data", file_name=str(mach_case))
        if len(mach_list) == 1 or abs(mach_val - MACH) < 1e-6:
            solver.file.write(file_type="case-data", file_name=str(CASE_FILE))
            print(f"[ork2cfd] Solved and saved case/data: {CASE_FILE}")

        zone_drag_sum = 0.0
        for rz in rocket_zones:
            rep = solver.tui.report.forces.wall_forces("no", rz, cos_a, sin_a, 0.0, "no")
            drag_n = _parse_total_force_n(rep) * SYM_FACTOR
            cd_z = (drag_n / (q_dyn * S_REF_M2)) if (q_dyn * S_REF_M2) > 0.0 else 0.0
            zone_drag_sum += drag_n
            aero_rows.append([
                ROCKET_NAME, mach_val, ALTITUDE_M, AOA_DEG, rz,
                f"{drag_n:.6f}", f"{cd_z:.6f}",
            ])

        if rocket_zones:
            tot_rep = solver.tui.report.forces.wall_forces(
                "no", *rocket_zones, cos_a, sin_a, 0.0, "no"
            )
            tot_drag_n = _parse_total_force_n(tot_rep) * SYM_FACTOR
            if abs(tot_drag_n) < 1e-12 and abs(zone_drag_sum) > 0.0:
                tot_drag_n = zone_drag_sum
        else:
            tot_drag_n = 0.0

        tot_cd = (tot_drag_n / (q_dyn * S_REF_M2)) if (q_dyn * S_REF_M2) > 0.0 else 0.0
        aero_rows.append([
            ROCKET_NAME, mach_val, ALTITUDE_M, AOA_DEG, "total",
            f"{tot_drag_n:.6f}", f"{tot_cd:.6f}",
        ])
        rocketpy_rows.append([mach_val, f"{tot_cd:.6f}"])

    with RESULTS_CSV.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["rocket", "mach", "altitude_m", "aoa_deg", "zone", "drag_force_n", "cd"])
        writer.writerows(aero_rows)

    with ROCKETPY_CSV.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["mach", "cd"])
        writer.writerows(rocketpy_rows)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run ork2cfd Fluent CFD workflow")
    parser.add_argument("--mach", nargs="+", type=float, default=None, help="Mach number list")
    parser.add_argument("--gui", action="store_true", help="Show Fluent GUI during run")
    args = parser.parse_args()
    run_cfd(show_gui=args.gui, mach_list=args.mach)
