; ANSYS Fluent Solver Journal
; Generated by ork2cfd for {{ rocket.name | replace('\n', ' ') | replace('\r', ' ') }}
; Regime: {{ solver_rec.regime.value }} | Mach {{ flight.mach }} | Alt {{ flight.altitude_m }} m | AoA {{ flight.aoa_deg }} deg
; Usage: fluent 3ddp -g -t{{ flight.cores }} -i {{ solver_jou_filename }}

{% set default_outer = ["farfield", "outlet"] if domain.shape.value == "bullet" else ["inlet", "farfield", "outlet"] %}
{% if domain.mode.value in ["symmetry_half", "symmetry_sector", "symmetry_half_sector"] %}
{% set default_outer = default_outer + ["symmetry"] %}
{% endif %}
{% set active_zones = zone_names if zone_names else (default_outer + ["rocket_nosecone", "rocket_body", "rocket_fins", "rocket_base"]) %}
{% set rocket_zones = [] %}
{% for zn in active_zones %}{% if zn.startswith("rocket_") %}{% set _ = rocket_zones.append(zn) %}{% endif %}{% endfor %}

/file/read-case {{ (stem ~ ".msh.h5") | tojson }}
/mesh/check

{% if solver_rec.solver_type == "density-based" %}
/define/models/solver/density-based-implicit yes
{% else %}
/define/models/solver/pressure-based yes
{% endif %}

{% if solver_rec.energy_enabled %}
/define/models/energy yes no no no no
/define/materials/change-create air air yes ideal-gas no no yes sutherland three-coefficient-method 1.716e-05 273.15 110.4 no no no
/define/operating-conditions/operating-pressure 0.0
{% else %}
/define/materials/change-create air air yes constant {{ "%.6f" | format(bl.atmosphere.density_kg_m3) }} no no yes constant {{ "%.8e" | format(bl.atmosphere.viscosity_pa_s) }} no no no
/define/operating-conditions/operating-pressure {{ "%.2f" | format(bl.atmosphere.pressure_pa) }}
{% endif %}

/define/models/viscous/kw-sst yes

; Reference values from OpenRocket geometry ({{ rocket.name | replace('\n', ' ') | replace('\r', ' ') }})
/report/reference-values/area {{ "%.8f" | format(rocket.reference_area / symmetry_multiplier) }}
/report/reference-values/length {{ "%.6f" | format(rocket.total_length) }}
/report/reference-values/velocity {{ "%.4f" | format(bl.velocity_m_s) }}
/report/reference-values/density {{ "%.6f" | format(bl.atmosphere.density_kg_m3) }}
/report/reference-values/viscosity {{ "%.8e" | format(bl.atmosphere.viscosity_pa_s) }}
/report/reference-values/temperature {{ "%.2f" | format(bl.atmosphere.temperature_k) }}

; Boundary conditions ({{ solver_rec.farfield_bc_type }} / {{ solver_rec.outlet_bc_type }})
{% for zname in active_zones %}
{% if zname in ["farfield", "inlet"] and solver_rec.farfield_bc_type == "pressure-far-field" %}
/define/boundary-conditions/zone-type {{ zname }} pressure-far-field
/define/boundary-conditions/pressure-far-field {{ zname }} no {{ "%.2f" | format(bl.atmosphere.pressure_pa) }} no {{ flight.mach }} no {{ "%.2f" | format(bl.atmosphere.temperature_k) }} no {{ "%.6f" | format(flow_dir_x) }} no {{ "%.6f" | format(flow_dir_y) }} no 0.0 no no yes 5 10
{% elif zname in ["inlet", "farfield"] %}
/define/boundary-conditions/zone-type {{ zname }} velocity-inlet
/define/boundary-conditions/velocity-inlet {{ zname }} no no yes yes no {{ "%.4f" | format(bl.velocity_m_s) }} no 0 no {{ "%.6f" | format(flow_dir_x) }} no {{ "%.6f" | format(flow_dir_y) }} no 0 no no yes 5 10
{% elif zname == "outlet" and solver_rec.outlet_bc_type == "pressure-outlet" %}
/define/boundary-conditions/zone-type outlet pressure-outlet
{% elif zname == "symmetry" %}
/define/boundary-conditions/zone-type symmetry symmetry
{% endif %}
{% endfor %}

{% if solver_rec.solver_type == "density-based" %}
/solve/set/flux-type ausm
/solve/set/courant-number 1.5
{% endif %}
/solve/initialize/hyb-initialization
/solve/iterate {{ flight.iterations }}

; Per-group and total aerodynamic drag force reports (direction = {{ "%.4f" | format(flow_dir_x) }}, {{ "%.4f" | format(flow_dir_y) }}, 0)
{% for rz in rocket_zones %}
/report/forces/wall-forces no {{ rz }} () {{ "%.6f" | format(flow_dir_x) }} {{ "%.6f" | format(flow_dir_y) }} 0.0 no
{% endfor %}
{% if rocket_zones %}
/report/forces/wall-forces no {{ rocket_zones | join(" ") }} () {{ "%.6f" | format(flow_dir_x) }} {{ "%.6f" | format(flow_dir_y) }} 0.0 no
{% endif %}

/file/write-case-data {{ (stem ~ ".cas.h5") | tojson }} yes
exit
