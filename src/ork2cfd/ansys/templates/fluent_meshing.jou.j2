; ANSYS Fluent Meshing Journal (Watertight Geometry Workflow)
; Generated by ork2cfd for {{ rocket.name | replace('\n', ' ') | replace('\r', ' ') }}
; Usage: fluent 3ddp -meshing -g -t{{ flight.cores }} -py -i run_fluent.py

/file/set-tui-version {{ ansys_version | tojson }}
(%wf-init-workflow "Watertight Geometry")
(%wf-set-var "Import Geometry" "FileName" {{ step_filename | tojson }})
(%wf-set-var "Import Geometry" "LengthUnit" "m")
(%wf-execute-task "Import Geometry")

; Local face sizing (fins = {{ "%.6f" | format(fin_face_size_m) }} m, nose = {{ "%.6f" | format(nose_face_size_m) }} m, body = {{ "%.6f" | format(bl.surface_max_size_m) }} m) & BOIs
{% if not zone_names or "rocket_fins" in zone_names %}
(%wf-set-var "Add Local Sizing" "AddChild" "yes")
(%wf-set-var "Add Local Sizing" "BOIControlName" "fin_face_sizing")
(%wf-set-var "Add Local Sizing" "BOIExecution" "Face Size")
(%wf-set-var "Add Local Sizing" "BOISize" {{ "%.6f" | format(fin_face_size_m) }})
(%wf-set-var "Add Local Sizing" "BOIFaceLabelList" '("rocket_fins"))
(%wf-add-child-and-update "Add Local Sizing")
{% endif %}

{% if not zone_names or "rocket_nosecone" in zone_names %}
(%wf-set-var "Add Local Sizing" "AddChild" "yes")
(%wf-set-var "Add Local Sizing" "BOIControlName" "nose_face_sizing")
(%wf-set-var "Add Local Sizing" "BOIExecution" "Face Size")
(%wf-set-var "Add Local Sizing" "BOISize" {{ "%.6f" | format(nose_face_size_m) }})
(%wf-set-var "Add Local Sizing" "BOIFaceLabelList" '("rocket_nosecone"))
(%wf-add-child-and-update "Add Local Sizing")
{% endif %}

{% set default_body_labels = ["rocket_body", "rocket_boattail", "rocket_base"] %}
{% set active_body_labels = [] %}
{% if zone_names %}
{% for lbl in default_body_labels %}{% if lbl in zone_names %}{% set _ = active_body_labels.append(lbl) %}{% endif %}{% endfor %}
{% else %}
{% set active_body_labels = default_body_labels %}
{% endif %}
{% if active_body_labels %}
(%wf-set-var "Add Local Sizing" "AddChild" "yes")
(%wf-set-var "Add Local Sizing" "BOIControlName" "body_face_sizing")
(%wf-set-var "Add Local Sizing" "BOIExecution" "Face Size")
(%wf-set-var "Add Local Sizing" "BOISize" {{ "%.6f" | format(bl.surface_max_size_m) }})
(%wf-set-var "Add Local Sizing" "BOIFaceLabelList" '({% for lbl in active_body_labels %}"{{ lbl }}"{% if not loop.last %} {% endif %}{% endfor %}))
(%wf-add-child-and-update "Add Local Sizing")
{% endif %}

{% if domain.boi.enabled %}
(%wf-set-var "Add Local Sizing" "AddChild" "yes")
(%wf-set-var "Add Local Sizing" "BOIControlName" "boi_nearfield_sizing")
(%wf-set-var "Add Local Sizing" "BOIExecution" "Body Of Influence")
(%wf-set-var "Add Local Sizing" "BOISize" {{ "%.6f" | format(bl.boi_nearfield_size_m) }})
(%wf-set-var "Add Local Sizing" "BOIFaceLabelList" '("boi_nearfield"))
(%wf-add-child-and-update "Add Local Sizing")

(%wf-set-var "Add Local Sizing" "AddChild" "yes")
(%wf-set-var "Add Local Sizing" "BOIControlName" "boi_wake_sizing")
(%wf-set-var "Add Local Sizing" "BOIExecution" "Body Of Influence")
(%wf-set-var "Add Local Sizing" "BOISize" {{ "%.6f" | format(bl.boi_wake_size_m) }})
(%wf-set-var "Add Local Sizing" "BOIFaceLabelList" '("boi_wake"))
(%wf-add-child-and-update "Add Local Sizing")
{% endif %}
(%wf-execute-task "Add Local Sizing")

(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.MinSize" {{ "%.6f" | format(bl.surface_min_size_m) }})
(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.MaxSize" {{ "%.6f" | format(bl.farfield_max_size_m) }})
(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.GrowthRate" 1.2)
(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.CurvatureNormalAngle" 12.0)
(%wf-execute-task "Generate the Surface Mesh")

{% if domain.mode.value == "fluid_domain" %}
(%wf-set-var "Describe Geometry" "SetupType" "The geometry consists of both fluid and solid regions and/or voids")
(%wf-set-var "Describe Geometry" "CappingRequired" "No")
(%wf-execute-task "Describe Geometry")
(%wf-execute-task "Update Boundaries")
(%wf-set-var "Create Regions" "NumberOfFlowVolumes" 0)
(%wf-execute-task "Create Regions")
(%wf-set-var "Update Regions" "OldRegionNameList" '("dead0"))
(%wf-set-var "Update Regions" "RegionTypeList" '("dead"))
(%wf-execute-task "Update Regions")
{% else %}
(%wf-set-var "Describe Geometry" "SetupType" "The geometry consists of only fluid regions with no voids")
(%wf-execute-task "Describe Geometry")
(%wf-execute-task "Update Boundaries")
(%wf-execute-task "Update Regions")
{% endif %}

; Boundary Layer (y+ = {{ bl.target_yplus }}, delta_y1 = {{ "%.3e" | format(bl.first_layer_thickness_m) }} m)
(%wf-set-var "Add Boundary Layers" "AddChild" "yes")
(%wf-set-var "Add Boundary Layers" "BLControlName" "rocket_bl")
(%wf-set-var "Add Boundary Layers" "OffsetMethodType" "uniform")
(%wf-set-var "Add Boundary Layers" "FirstHeight" {{ "%.8e" | format(bl.first_layer_thickness_m) }})
(%wf-set-var "Add Boundary Layers" "NumberOfLayers" {{ bl.prism_layers }})
(%wf-set-var "Add Boundary Layers" "Rate" {{ bl.prism_growth_rate }})
(%wf-add-child-and-update "Add Boundary Layers")
(%wf-execute-task "Add Boundary Layers")

(%wf-set-var "Generate the Volume Mesh" "VolumeFill" "poly-hexcore")
(%wf-execute-task "Generate the Volume Mesh")

/file/write-mesh {{ (stem ~ ".msh.h5") | tojson }}
/switch-to-solution-mode yes
exit
