; ANSYS Fluent Meshing Journal (Watertight Geometry Workflow)
; Generated by ork2cfd for "{{ rocket.name }}"
; Usage: fluent 3ddp -meshing -g -t{{ flight.cores }} -i {{ meshing_jou_filename }}

/file/set-tui-version "{{ ansys_version }}"
(%wf-init-workflow "Watertight Geometry")
(%wf-set-var "Import Geometry" "FileName" "{{ step_filename }}")
(%wf-set-var "Import Geometry" "LengthUnit" "m")
(%wf-execute-task "Import Geometry")

(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.MinSize" {{ "%.6f" | format(bl.surface_min_size_m) }})
(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.MaxSize" {{ "%.6f" | format(bl.surface_max_size_m) }})
(%wf-set-var "Generate the Surface Mesh" "CFDSurfaceMeshControls.GrowthRate" 1.2)
(%wf-execute-task "Generate the Surface Mesh")

(%wf-set-var "Describe Geometry" "SetupType" "The geometry consists of only fluid regions")
(%wf-set-var "Describe Geometry" "CappingRequired" "No")
(%wf-execute-task "Describe Geometry")

(%wf-execute-task "Update Boundaries")
(%wf-execute-task "Create Regions")
(%wf-execute-task "Update Regions")

; Boundary Layer (y+ = {{ bl.target_yplus }}, delta_y1 = {{ "%.3e" | format(bl.first_layer_thickness_m) }} m)
(%wf-set-var "Add Boundary Layers" "NumberOfLayers" {{ bl.prism_layers }})
(%wf-set-var "Add Boundary Layers" "Rate" {{ bl.prism_growth_rate }})
(%wf-execute-task "Add Boundary Layers")

(%wf-set-var "Generate the Volume Mesh" "VolumeFill" "poly-hexcore")
(%wf-execute-task "Generate the Volume Mesh")

/file/write-mesh "{{ stem }}.msh.h5"
/switch-to-solution-mode yes
exit
