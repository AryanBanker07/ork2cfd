# ANSYS Discovery / SpaceClaim Geometry Preparation Script
# Generated by ork2cfd for {{ rocket.name | replace('\n', ' ') | replace('\r', ' ') }}
# Purpose: Import STEP, verify/re-apply Named Selections from geometry_manifest.json,
#          and save a clean native Discovery/SpaceClaim file if needed.

import json
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__)) if "__file__" in globals() else os.getcwd()
MANIFEST_PATH = os.path.join(SCRIPT_DIR, {{ manifest_filename | tojson }})
STEP_PATH = os.path.join(SCRIPT_DIR, {{ step_filename | tojson }})

with open(MANIFEST_PATH, "r") as f:
    manifest = json.load(f)

print("Loaded manifest for:", manifest["rocket_name"])
print("Expected solids:", manifest["solid_names"])
print("Expected Named Selections:", manifest["named_selections_counts"])

# Open STEP into active session
DocumentOpen.Execute(STEP_PATH)
root = GetRootPart()

existing_groups = {g.GetName(): g for g in Window.ActiveWindow.Document.Groups}
print("Imported Named Selection groups:", list(existing_groups.keys()))

# Geometric centroid fallback if any Named Selection was dropped by CAD import settings
centroids_map = manifest.get("named_selections_centroids_m", {})
if not existing_groups and centroids_map:
    print("Reconstructing Named Selections from manifest face centroids...")
    all_faces = []
    for body in root.GetAllBodies():
        if body.GetName().startswith("boi_"):
            continue
        for face in body.Faces:
            mid = face.EvalMid().Point
            all_faces.append((face, (mid.X, mid.Y, mid.Z)))

    for zone_name, targets in centroids_map.items():
        matched = []
        for tx, ty, tz in targets:
            best_face = None
            best_d2 = 1e9
            for face, (fx, fy, fz) in all_faces:
                d2 = (fx - tx) ** 2 + (fy - ty) ** 2 + (fz - tz) ** 2
                if d2 < best_d2:
                    best_d2 = d2
                    best_face = face
            if best_face is not None and best_d2 < 0.05:
                matched.append(best_face)
        if matched:
            Selection.Create(matched).CreateAGroup(zone_name)
            print("Created Named Selection:", zone_name, "faces=", len(matched))

print("Discovery geometry preparation complete.")
